---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
---
<section id="lineup"><div class="wrap">
  <div class="head"><span class="mono" data-i18n="lu.kicker" set:html={L('lu.kicker', lang)}></span><h2 data-i18n="lu.title" set:html={L('lu.title', lang)}></h2><p data-i18n="lu.sub" set:html={L('lu.sub', lang)}></p></div>
  <div class="line">
    <a class="pc" href="/typixdeck"><div class="ph"><img src="/assets/cyberdeck.png" alt="TypixDeck"></div><h3>TypixDeck</h3><p class="ds" data-i18n="p.deck.ds" set:html={L('p.deck.ds', lang)}></p><div class="foot"><span class="pr" data-usd="119">$119</span><button class="add" data-add="typixdeck" aria-label="Add">+</button></div></a>
    <a class="pc" href="/keyboard"><div class="ph"><img src="/assets/keyboard.jpg" alt="BLE Keyboard"></div><h3>BLE Keyboard</h3><p class="ds" data-i18n="p.kb.ds" set:html={L('p.kb.ds', lang)}></p><div class="foot"><span class="pr" data-usd="39">$39</span><button class="add" data-add="keyboard" aria-label="Add">+</button></div></a>
    <a class="pc" href="/diysuite"><div class="ph"><img src="/assets/diysuite.jpg" alt="DIY Suite"></div><h3>DIY Suite</h3><p class="ds" data-i18n="p.diy.ds" set:html={L('p.diy.ds', lang)}></p><div class="foot"><span class="pr" data-usd="9">$9</span><button class="add" data-add="diysuite" aria-label="Add">+</button></div></a>
    <a class="pc" href="/picomac"><div class="ph"><img src="/assets/picomac.jpg" alt="Pico-Mac Nano"></div><h3>Pico-Mac Nano</h3><p class="ds" data-i18n="p.mac.ds" set:html={L('p.mac.ds', lang)}></p><div class="foot"><span class="pr" data-usd="60">$60</span><button class="add" data-add="picomac" aria-label="Add">+</button></div></a>
  </div>
</div></section>
