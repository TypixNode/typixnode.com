---
interface NavLink { href: string; key: string; label: string; }
interface Props {
  links?: NavLink[];
  buyHref?: string;
  buyAdd?: string;
  showBuy?: boolean;
}
const homeLinks: NavLink[] = [
  { href: '/typixdeck', key: 'nav.deck', label: 'TypixDeck' },
  { href: '/#products', key: 'nav.all', label: 'All products' },
  { href: '/#why', key: 'nav.tech', label: 'Technology' },
  { href: 'https://github.com/TypixNode', key: 'nav.open', label: 'Open' },
];
const { links = homeLinks, buyHref = '/typixdeck', buyAdd, showBuy = true } = Astro.props;
---
{/* Liquid-glass refraction filter (Chromium honours it in backdrop-filter;
    Safari/Firefox ignore the url() and fall back to the frosted blur in CSS). */}
<svg class="tnx-glass-defs" aria-hidden="true" focusable="false" width="0" height="0">
  <filter id="tnx-liquid-glass" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.009 0.013" numOctaves="2" seed="11" result="noise" />
    <feGaussianBlur in="noise" stdDeviation="2.2" result="softNoise" />
    <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="26" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
<nav><div class="nav">
  <a class="brand" href="/">
    <img class="logo-lt" src="/assets/typixnode-logo.svg" alt="TypixNode">
    <img class="logo-dk" src="/assets/typixnode-logo-inverse.svg" alt="TypixNode">
  </a>
  <div class="links">
    {links.map((l) => <a href={l.href} data-i18n={l.key}>{l.label}</a>)}
  </div>
  <span class="sp"></span>
  <div class="ctrls">
    <button class="ctrl themebtn" aria-label="Toggle theme"><span class="ti">☾</span></button>
    <span class="selwrap lang"><select id="langsel" aria-label="Language"><option value="en">EN</option><option value="zh">中文</option><option value="ja">日本語</option></select></span>
    <span class="selwrap cur"><select id="cursel" aria-label="Currency"><option>USD</option><option>EUR</option><option>GBP</option><option>CNY</option><option>JPY</option></select></span>
    <button class="ctrl cartbtn" aria-label="Cart">🛍<span class="cc">0</span></button>
    {showBuy && (buyAdd
      ? <button class="btn btn--fill navbuy" data-add={buyAdd} data-i18n="nav.buy">Buy now</button>
      : <a class="btn btn--fill navbuy" href={buyHref} data-i18n="nav.buy">Buy now</a>)}
    <button class="burger" id="burger">☰</button>
  </div>
</div></nav>
<div class="mobnav" id="mobnav">
  {links.map((l) => <a href={l.href} data-i18n={l.key}>{l.label}</a>)}
</div>
