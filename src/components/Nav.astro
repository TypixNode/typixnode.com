---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
interface NavLink { href: string; key: string; label: string; }
interface Props {
  links?: NavLink[];
  buyHref?: string;
  buyAdd?: string;
  showBuy?: boolean;
}
const homeLinks: NavLink[] = [
  { href: '/typixdeck', key: 'nav.deck', label: 'TypixDeck' },
  { href: '/products', key: 'nav.all', label: 'All products' },
  { href: '/#why', key: 'nav.tech', label: 'Technology' },
  { href: 'https://github.com/TypixNode', key: 'nav.open', label: 'Open' },
];
const { links = homeLinks, buyHref = '/typixdeck', buyAdd, showBuy = true } = Astro.props;
const langOpts: [string, string][] = [
  ['en', 'English'], ['zh', '简体中文'], ['zh-Hant', '繁體中文'], ['ja', '日本語'],
  ['de', 'Deutsch'], ['fr', 'Français'], ['es', 'Español'], ['pt', 'Português'],
  ['ko', '한국어'], ['it', 'Italiano'],
];
const curOpts: string[] = ['USD', 'EUR', 'GBP', 'CNY', 'JPY'];
const DISCORD_INVITE = 'https://discord.gg/FZaCtnvk4d';
const dIcon = `<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>`;
---
<nav><div class="nav">
  <a class="brand" href="/">
    <img class="logo-lt" src="/assets/typixnode-logo.svg" alt="TypixNode">
    <img class="logo-dk" src="/assets/typixnode-logo-inverse.svg" alt="TypixNode">
  </a>
  <div class="links">
    {links.map((l) => <a href={l.href} data-i18n={l.key} set:html={L(l.key, lang)}></a>)}
  </div>
  <span class="sp"></span>
  <div class="ctrls">
    <button class="ctrl themebtn" aria-label="Toggle theme"><span class="ti">☾</span></button>
    <span class="selwrap lang"><select class="js-langsel" id="langsel" aria-label="Language">{langOpts.map(([v, l]) => <option value={v}>{l}</option>)}</select></span>
    <span class="selwrap cur"><select class="js-cursel" id="cursel" aria-label="Currency">{curOpts.map((c) => <option>{c}</option>)}</select></span>
    <a class="dc-nav" href={DISCORD_INVITE} target="_blank" rel="noopener" aria-label="Discord"><span set:html={dIcon}></span>Discord</a>
    <button class="ctrl cartbtn" aria-label="Cart">🛍<span class="cc">0</span></button>
    {showBuy && (buyAdd
      ? <button class="btn btn--fill navbuy" data-add={buyAdd} data-i18n="nav.buy" set:html={L('nav.buy', lang)}></button>
      : <a class="btn btn--fill navbuy" href={buyHref} data-i18n="nav.buy" set:html={L('nav.buy', lang)}></a>)}
    <button class="burger" id="burger" aria-label="Menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg></button>
  </div>
</div></nav>
<div class="mobnav" id="mobnav">
  {links.map((l) => <a href={l.href} data-i18n={l.key} set:html={L(l.key, lang)}></a>)}
  <div class="mrow">
    <span class="selwrap lang"><select class="js-langsel" aria-label="Language">{langOpts.map(([v, l]) => <option value={v}>{l}</option>)}</select></span>
    <span class="selwrap cur"><select class="js-cursel" aria-label="Currency">{curOpts.map((c) => <option>{c}</option>)}</select></span>
  </div>
  <a class="dc-nav" href={DISCORD_INVITE} target="_blank" rel="noopener"><span set:html={dIcon}></span>Discord</a>
</div>
