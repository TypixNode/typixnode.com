---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
---
<footer><div class="wrap"><div class="ft">
  <div class="nlcard" id="newsletter">
    <div class="nlcopy">
      <h3 data-i18n="nl.title" set:html={L('nl.title', lang)}></h3>
      <p data-i18n="nl.sub" set:html={L('nl.sub', lang)}></p>
    </div>
    <form class="nlform" id="nlform" novalidate>
      <div class="nlrow">
        <input class="nlinput" type="email" name="email" autocomplete="email" required placeholder={L('nl.email', lang)} data-i18n-ph="nl.email" />
        <button class="nlbtn" type="submit" data-i18n="nl.btn" set:html={L('nl.btn', lang)}></button>
      </div>
      <p class="nlmsg" id="nlmsg" role="status" aria-live="polite"></p>
    </form>
  </div>
  <div class="top">
    <div class="brandcol">
      <img class="logo-lt" src="/assets/typixnode-logo.svg" alt="TypixNode"><img class="logo-dk" src="/assets/typixnode-logo-inverse.svg" alt="TypixNode">
      <p data-i18n="ft.tag" set:html={L('ft.tag', lang)}></p>
    </div>
    <div class="col"><h4 data-i18n="ft.products" set:html={L('ft.products', lang)}></h4><a href="/typixdeck">TypixDeck</a><a href="/keyboard">BLE Keyboard</a><a href="/diysuite">DIY Suite</a><a href="/picomac">Pico-Mac Nano</a></div>
    <div class="col"><h4 data-i18n="ft.company" set:html={L('ft.company', lang)}></h4><a href="/orders" data-i18n="nav.orders" set:html={L('nav.orders', lang)}></a><a href="/about" data-i18n="ft.about" set:html={L('ft.about', lang)}></a><a href="/support" data-i18n="ft.support" set:html={L('ft.support', lang)}></a><a href="/support" data-i18n="ft.shipping" set:html={L('ft.shipping', lang)}></a><a href="/support" data-i18n="ft.warranty" set:html={L('ft.warranty', lang)}></a></div>
    <div class="col"><h4 data-i18n="ft.open" set:html={L('ft.open', lang)}></h4><a href="https://github.com/TypixNode">GitHub ↗</a><a href="#" data-i18n="ft.cad" set:html={L('ft.cad', lang)}></a><a href="#" data-i18n="ft.fw" set:html={L('ft.fw', lang)}></a><a href="#" data-i18n="ft.docs" set:html={L('ft.docs', lang)}></a></div>
  </div>
  <div class="bot"><span data-i18n="ft.copy" set:html={L('ft.copy', lang)}></span><a href="mailto:support@typixnode.com">support@typixnode.com</a></div>
</div></div></footer>
