      <span class="arr">↗</span>
      <b>GitHub</b><span class="d" data-i18n="dc.card.gh" set:html={L("dc.card.gh", lang)}></span>
    </a>
    <a class="dc-gcard" href={X_URL} target="_blank" rel="noopener">
