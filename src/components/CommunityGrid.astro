<section class="dc-hub"><div class="wrap">
  <div class="dc-hub-head">
    <h3 data-i18n="dc.hub.title" set:html={L("dc.hub.title", lang)}></h3>
    <p data-i18n="dc.hub.sub" set:html={L("dc.hub.sub", lang)}></p>
  </div>
  <div class="dc-grid">
    <a class="dc-gcard" href={INVITE} target="_blank" rel="noopener">
      <span class="ic dc" set:html={dIcon}></span>
      <span class="arr">↗</span>
      <b>Discord</b><span class="d" data-i18n="dc.card.dc" set:html={L("dc.card.dc", lang)}></span>
    </a>
    <a class="dc-gcard" href={GITHUB} target="_blank" rel="noopener">
