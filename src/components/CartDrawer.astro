---
<div class="cart-ov" id="cartOv"></div>
<aside class="cart" id="cartDrawer" aria-label="Cart">
  <div class="ch"><h3 data-i18n="cart.title" set:html={L('cart.title', lang)}></h3><button class="x" data-cart-close aria-label="Close">✕</button></div>
  <div class="items" id="cartItems"></div>
  <div class="cf">
    <div class="sub"><span data-i18n="cart.sub" set:html={L('cart.sub', lang)}></span><b id="cartSub">$0</b></div>
    <div class="cart-cta" id="cartCta">
      <button class="cart-ks" type="button" disabled>
        <span class="cart-ks__soon" data-i18n="cart.ks.soon" set:html={L('cart.ks.soon', lang)}></span>
        <span data-i18n="cart.ks" set:html={L('cart.ks', lang)}></span>
      </button>
      <div class="cart-or" data-i18n="cart.or" set:html={L('cart.or', lang)}></div>
      <a class="cart-dc" href={DISCORD_INVITE} target="_blank" rel="noopener">
        <span class="cart-dc__ic" set:html={dIcon}></span>
        <span data-i18n="cart.discord" set:html={L('cart.discord', lang)}></span>
      </a>
    </div>
    <div class="cart-note" id="cartNote" data-i18n="cart.note" set:html={L('cart.note', lang)}></div>
    <div class="cart-err" id="cartErr"></div>
  </div>
</aside>
