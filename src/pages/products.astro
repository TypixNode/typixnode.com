---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';

// All SKUs grouped by category. id -> data-add (cart), usd -> data-usd (price),
// href -> detail/anchor, ds -> i18n key for the description (falls back to name).
const links = [
  { href: '/typixdeck', key: 'nav.deck', label: 'TypixDeck' },
  { href: '/products', key: 'nav.all', label: 'All products' },
  { href: '/#why', key: 'nav.tech', label: 'Technology' },
  { href: 'https://github.com/TypixNode', key: 'nav.open', label: 'Open' },
];

interface Card {
  id: string;        // data-add
  usd: number;       // data-usd
  href: string;
  name: string;      // English default (model/SKU names mostly stay in English)
  img: string;
  ds?: string;       // i18n key for a longer description
  alt: string;
  tag?: string;      // i18n key for a badge
  fromPrice?: boolean; // show "from $X" (configurable product) instead of a flat price
}

// TypixDeck is one configurable product (base $119 + compute/storage option
// deltas), so it's a single "from $119" card that opens the configurator on
// /typixdeck — not separate CM0/CM4/CM5 SKUs.
const computers: Card[] = [
  { id: 'typixdeck', usd: 119, href: '/typixdeck#buy', name: 'TypixDeck', img: '/assets/cyberdeck.png', alt: 'TypixDeck', ds: 'p.deck.ds', tag: 'tag.flagship', fromPrice: true },
  { id: 'picomac', usd: 60, href: '/picomac', name: 'Pico-Mac Nano', img: '/assets/picomac.jpg', alt: 'Pico-Mac Nano', ds: 'p.mac.ds' },
];

const keyboards: Card[] = [
  { id: 'keyboard', usd: 39, href: '/keyboard', name: 'BLE Keyboard', img: '/assets/keyboard.jpg', alt: 'BLE Keyboard', ds: 'p.kb.ds' },
  { id: 'keyboard-wired', usd: 29, href: '/keyboard', name: 'Wired Keyboard', img: '/assets/keyboard.jpg', alt: 'Wired Keyboard' },
  { id: 'diysuite', usd: 9, href: '/diysuite', name: 'DIY Suite', img: '/assets/diysuite.jpg', alt: 'DIY Suite', ds: 'p.diy.ds' },
];

const modules: Card[] = [
  { id: 'cm0-adapter', usd: 40, href: '/typixdeck#buy', name: 'CM0 Adapter', img: '/assets/cm0-adapter.png', alt: 'CM0→CM4 adapter with CM0 soldered', ds: 'p.cm0adp.ds', tag: 'tag.new' },
  { id: 'cm0-module', usd: 30, href: '/typixdeck#buy', name: 'CM0 Module', img: '/assets/cm0-module.jpeg', alt: 'CM0 module', ds: 'p.cm0.ds' },
  { id: 'cm0-adapter-raw', usd: 10, href: '/typixdeck#buy', name: 'CM0 Adapter (bare)', img: '/assets/cm0-adapter-raw.png', alt: 'Bare CM0→CM4 adapter PCB', ds: 'p.cm0raw.ds' },
];

const sections = [
  { key: 'pg.sec.compute', label: 'Computers', items: computers },
  { key: 'pg.sec.kb', label: 'Keyboards', items: keyboards },
  { key: 'pg.sec.mod', label: 'Compute modules & adapters', items: modules },
];
---
<Layout title="All products — TypixNode" titleKey="pg.title">
  <Nav links={links} />

  <section class="pg-hero"><div class="wrap">
    <span class="mono" data-i18n="pg.kicker" set:html={L('pg.kicker', lang)}></span>
    <h1 data-i18n="pg.title" set:html={L('pg.title', lang)}></h1>
    <p class="lead" data-i18n="pg.sub" set:html={L('pg.sub', lang)}></p>
  </div></section>

  {sections.map((sec) => (
    <section class="pg-sec"><div class="wrap">
      <h2 class="pg-sec__h" data-i18n={sec.key} set:html={L(sec.key, lang)}></h2>
      <div class="grid">
        {sec.items.map((p) => (
          <a class="pc" href={p.href}>
            <div class="ph">
              {p.tag && <span class="tag" data-i18n={p.tag} set:html={L(p.tag, lang)}></span>}
              <img src={p.img} alt={p.alt} loading="lazy" />
            </div>
            <h3>{p.name}</h3>
            {p.ds
              ? <p class="ds" data-i18n={p.ds} set:html={L(p.ds, lang)}></p>
              : <p class="ds">{p.name}</p>}
            <div class="foot">
              <span class="pr" data-usd={p.usd}>
                {p.fromPrice && <span class="from" data-i18n="pg.from" set:html={L('pg.from', lang)}></span>}${p.usd}
              </span>
              {p.fromPrice
                ? <span class="add cfg" aria-hidden="true" data-i18n="pg.configure" set:html={L('pg.configure', lang)}></span>
                : <button class="add" data-add={p.id} aria-label="Add">+</button>}
            </div>
          </a>
        ))}
      </div>
    </div></section>
  ))}

  <Footer />
  <CartDrawer />
</Layout>

<style>
  .pr .from { font-size: 0.7em; opacity: 0.7; font-weight: 400; }
  /* Configurable products show a "Configure ›" affordance instead of a + add button. */
  .add.cfg {
    width: auto;
    padding: 0 0.6em;
    font-size: 0.8rem;
    line-height: 1.9;
    white-space: nowrap;
  }
</style>
