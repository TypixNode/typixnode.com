---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Lineup from '../components/Lineup.astro';
const links = [
  { href: '#features', key: 'nav.features', label: 'Features' },
  { href: '#specs', key: 'nav.specs', label: 'Specs' },
  { href: '#faq', key: 'nav.faq', label: 'FAQ' },
  { href: '/products', key: 'nav.all', label: 'All products' },
];
---
<Layout
  title="DIY Suite — open-source keyboard build kit | TypixNode"
  titleKey="doc.diy"
  description="The TypixNode DIY Suite — an open-source, through-hole-friendly keyboard build kit with an illustrated guide and QMK firmware. Build it in an afternoon."
  ogTitle="DIY Suite — open-source keyboard build kit"
  ogDescription="An open-source, through-hole-friendly keyboard build kit with an illustrated guide and QMK firmware."
>
  <Nav links={links} buyAdd="diysuite" />

  <header class="prod"><div class="wrap">
    <div class="hero">
      <div class="copy">
        <span class="chip rise d1"><span class="d"></span><span class="mono" data-i18n="hero.badge" set:html={L('hero.badge', lang)}></span></span>
        <h1 class="rise d2" data-i18n="diy.h1" set:html={L('diy.h1', lang)}></h1>
        <p class="lead rise d3" data-i18n="diy.lead" set:html={L('diy.lead', lang)}></p>
        <div class="price rise d3"><b data-usd="9">$9</b><span class="ship" data-i18n="deck.ship" set:html={L('deck.ship', lang)}></span></div>
        <div class="cta rise d3"><button class="btn btn--fill" data-add="diysuite" data-i18n="cart.add" set:html={L('cart.add', lang)}></button><a class="btn btn--glass" href="#features" data-i18n="look" set:html={L('look', lang)}></a></div>
        <div class="trust rise d4"><span class="d"></span> <span data-i18n="deck.trust" set:html={L('deck.trust', lang)}></span></div>
      </div>
      <div class="stage rise d4">
        <span class="pin p1"><div class="k">DIY Suite</div><div class="v" data-i18n="diy.s3l" set:html={L('diy.s3l', lang)}></div></span>
        <img src="/assets/diysuite.jpg" alt="TypixNode DIY Suite" style="border-radius:18px">
        <span class="pin p2"><div class="k"><span data-usd="9">$9</span></div><div class="v" data-i18n="pin.stock" set:html={L('pin.stock', lang)}></div></span>
      </div>
    </div>
    <div class="strip rise d4"><div class="in">
      <div class="stat"><div class="n grad">~2 h</div><div class="l" data-i18n="diy.s1l" set:html={L('diy.s1l', lang)}></div></div>
      <div class="stat"><div class="n grad">48</div><div class="l" data-i18n="diy.s2l" set:html={L('diy.s2l', lang)}></div></div>
      <div class="stat"><div class="n grad">QMK</div><div class="l" data-i18n="diy.s3l" set:html={L('diy.s3l', lang)}></div></div>
      <div class="stat"><div class="n grad">100%</div><div class="l" data-i18n="diy.s4l" set:html={L('diy.s4l', lang)}></div></div>
      <div class="social" data-i18n="st.social" set:html={L('st.social', lang)}></div>
    </div></div>
  </div></header>

  <section><div class="wrap">
    <div class="rows"><div class="row">
      <div class="rimg"><img src="/assets/diysuite-exploded.jpg" alt="DIY Suite parts"></div>
      <div class="rtxt"><div class="ic">DIY Suite</div><h3 data-i18n="diy.row.t" set:html={L('diy.row.t', lang)}></h3><p data-i18n="diy.row.p" set:html={L('diy.row.p', lang)}></p></div>
    </div></div>
  </div></section>

  <section id="features"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="f.kicker" set:html={L('f.kicker', lang)}></span><h2 data-i18n="diy.feat" set:html={L('diy.feat', lang)}></h2></div>
    <div class="feat">
      <div class="c"><div class="ic">✎</div><h4 data-i18n="diy.f1t" set:html={L('diy.f1t', lang)}></h4><p data-i18n="diy.f1p" set:html={L('diy.f1p', lang)}></p></div>
      <div class="c"><div class="ic">⚿</div><h4 data-i18n="diy.f2t" set:html={L('diy.f2t', lang)}></h4><p data-i18n="diy.f2p" set:html={L('diy.f2p', lang)}></p></div>
      <div class="c"><div class="ic">⌨</div><h4 data-i18n="diy.f3t" set:html={L('diy.f3t', lang)}></h4><p data-i18n="diy.f3p" set:html={L('diy.f3p', lang)}></p></div>
    </div>
  </div></section>

  <section id="specs"><div class="wrap">
    <div class="head"><span class="mono">DIY Suite</span><h2 data-i18n="sp.title" set:html={L('sp.title', lang)}></h2></div>
    <div class="spectbl">
      <div class="r"><div class="k" data-i18n="diy.spk1" set:html={L('diy.spk1', lang)}></div><div class="v" data-i18n="diy.spv1" set:html={L('diy.spv1', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="diy.spk2" set:html={L('diy.spk2', lang)}></div><div class="v" data-i18n="diy.spv2" set:html={L('diy.spv2', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="diy.spk3" set:html={L('diy.spk3', lang)}></div><div class="v" data-i18n="diy.spv3" set:html={L('diy.spv3', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="diy.spk4" set:html={L('diy.spk4', lang)}></div><div class="v" data-i18n="diy.spv4" set:html={L('diy.spv4', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="diy.spk5" set:html={L('diy.spk5', lang)}></div><div class="v" data-i18n="diy.spv5" set:html={L('diy.spv5', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="diy.spk6" set:html={L('diy.spk6', lang)}></div><div class="v" data-i18n="diy.spv6" set:html={L('diy.spv6', lang)}></div></div>
    </div>
  </div></section>

  <section id="faq"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="faq.kicker" set:html={L('faq.kicker', lang)}></span><h2 data-i18n="faq.title" set:html={L('faq.title', lang)}></h2></div>
    <div class="faq">
      <div class="qa"><button><span data-i18n="diy.q1" set:html={L('diy.q1', lang)}></span> <span class="pm">+</span></button><div class="ans"><p data-i18n="diy.a1" set:html={L('diy.a1', lang)}></p></div></div>
      <div class="qa"><button><span data-i18n="diy.q2" set:html={L('diy.q2', lang)}></span> <span class="pm">+</span></button><div class="ans"><p data-i18n="diy.a2" set:html={L('diy.a2', lang)}></p></div></div>
    </div>
  </div></section>

  <Lineup />

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="diy.cta.t" set:html={L('diy.cta.t', lang)}></h2>
      <p data-i18n="diy.cta.p" set:html={L('diy.cta.p', lang)}></p>
      <div class="cta"><button class="btn btn--fill" data-add="diysuite" data-i18n="cart.add" set:html={L('cart.add', lang)}></button><a class="btn btn--glass" href="/products" data-i18n="see.all" set:html={L('see.all', lang)}></a></div>
    </div>
  </div></section>

  <Footer />
  <CartDrawer />
</Layout>
