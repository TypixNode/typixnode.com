---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
const links = [
  { href: '/products', key: 'nav.all', label: 'All products' },
  { href: '/typixdeck', key: 'nav.deck', label: 'TypixDeck' },
  { href: '/support', key: 'ft.support', label: 'Support' },
];
---
<Layout
  title="About — TypixNode"
  titleKey="about.doc"
  description="TypixNode is a tiny studio designing and milling compact open hardware in small batches — a few machines, made very well."
  ogTitle="About — TypixNode"
  ogDescription="A tiny studio designing and milling compact open hardware in small batches."
>
  <Nav links={links} showBuy={false} />

  <section style="padding-top:64px"><div class="wrap">
    <div class="head">
      <span class="mono" data-i18n="about.kicker" set:html={L('about.kicker', lang)}></span>
      <h2 data-i18n="about.h1" set:html={L('about.h1', lang)}></h2>
      <p data-i18n="about.lead" set:html={L('about.lead', lang)}></p>
    </div>
    <div class="rows"><div class="row">
      <div class="rimg"><img src="/assets/cyberdeck-internals.png" alt="Inside a TypixNode machine"></div>
      <div class="rtxt"><div class="ic" data-i18n="about.kicker" set:html={L('about.kicker', lang)}></div><h3 data-i18n="about.believe" set:html={L('about.believe', lang)}></h3><p data-i18n="about.story" set:html={L('about.story', lang)}></p></div>
    </div></div>
  </div></section>

  <section style="padding-top:0"><div class="wrap">
    <div class="feat">
      <div class="c"><div class="ic">⚿</div><h4 data-i18n="about.v1t" set:html={L('about.v1t', lang)}></h4><p data-i18n="about.v1p" set:html={L('about.v1p', lang)}></p></div>
      <div class="c"><div class="ic">◑</div><h4 data-i18n="about.v2t" set:html={L('about.v2t', lang)}></h4><p data-i18n="about.v2p" set:html={L('about.v2p', lang)}></p></div>
      <div class="c"><div class="ic">∞</div><h4 data-i18n="about.v3t" set:html={L('about.v3t', lang)}></h4><p data-i18n="about.v3p" set:html={L('about.v3p', lang)}></p></div>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="lu.title" set:html={L('lu.title', lang)}></h2>
      <p data-i18n="lu.sub" set:html={L('lu.sub', lang)}></p>
      <div class="cta"><a class="btn btn--fill" href="/products" data-i18n="see.all" set:html={L('see.all', lang)}></a><a class="btn btn--glass" href="/support" data-i18n="ft.support" set:html={L('ft.support', lang)}></a></div>
    </div>
  </div></section>

  <Footer />
  <CartDrawer />
</Layout>
