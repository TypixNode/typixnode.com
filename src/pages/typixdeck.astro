---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Viewer3D from '../components/Viewer3D.astro';
const links = [
  { href: '#features', key: 'nav.features', label: 'Features' },
  { href: '#inside', key: 'nav.inside', label: 'Inside' },
  { href: '/products', key: 'nav.all', label: 'All products' },
  { href: '#specs', key: 'nav.specs', label: 'Specs' },
  { href: '#faq', key: 'nav.faq', label: 'FAQ' },
];

// Headline A/B variants switchable via ?h=1..6 (1-3 = aluminum craft, 4-6 = hackable/open).
// Falls back to v1 when the param is missing or invalid.
const hRaw = Astro.url.searchParams.get('h');
const hNum = Number(hRaw);
const hVariant = Number.isInteger(hNum) && hNum >= 1 && hNum <= 6 ? hNum : 1;
const h1Key = `deck.h1.v${hVariant}`;

// Hero right-column top-gap fix, switchable via ?fix=fill | ?fix=narrow.
// Anything else (or missing) = baseline (unchanged current behavior).
// Coexists with ?h=1..6, e.g. ?h=2&fix=fill.
const fixRaw = (Astro.url.searchParams.get('fix') || '').toLowerCase();
const heroFix = (fixRaw === 'fill' || fixRaw === 'narrow') ? fixRaw : 'baseline';
---
<Layout
  title="TypixDeck — A fanless Linux computer | TypixNode"
  titleKey="doc.deck"
  description="TypixDeck — a thin, palm-sized fanless Linux computer in a CNC-machined aluminum body, built around a Raspberry Pi Compute Module."
  ogTitle="TypixDeck — A fanless Linux computer"
  ogDescription="A thin, palm-sized fanless Linux computer in a CNC-machined aluminum body, built around a Raspberry Pi Compute Module."
>
  <Nav links={links} buyAdd="typixdeck" />

  <header class="prod" id="buy"><div class="wrap">
    <div class="hero" data-fix={heroFix}>
      <div class="copy">
        <span class="chip rise d1"><span class="d"></span><span class="mono" data-i18n="hero.badge" set:html={L('hero.badge', lang)}></span></span>
        <h1 class="rise d2" data-i18n={h1Key} set:html={L(h1Key, lang)}></h1>
        <p class="lead rise d3" data-i18n="deck.lead" set:html={L('deck.lead', lang)}></p>
      </div>

      <div class="stage rise d4">
        <span class="savebadge r"><span data-i18n="save.title" set:html={L('save.title', lang)}></span><small data-i18n="save.sub" set:html={L('save.sub', lang)}></small></span>
        <span class="pin p1"><div class="k">TypixDeck</div><div class="v" data-i18n="pin.fanless" set:html={L('pin.fanless', lang)}></div></span>
        <img src="/assets/cyberdeck.png" alt="TypixDeck — fanless Linux computer">
        <span class="pin p2"><div class="k">0 dB</div><div class="v" data-i18n="pin.silent" set:html={L('pin.silent', lang)}></div></span>
      </div>

      <div class="cfg rise d3" data-cfg="typixdeck">
        <div class="cfg__group">
          <div class="cfg__label" data-i18n="cfg.compute" set:html={L('cfg.compute', lang)}></div>
          <div class="cfg__opts">
            <label class="cfg__opt"><input type="radio" name="cfg-compute" value="body" checked><span class="cfg__t" data-i18n="cfg.compute.body" set:html={L('cfg.compute.body', lang)}></span><span class="cfg__d" data-i18n="cfg.delta.0" set:html={L('cfg.delta.0', lang)}></span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-compute" value="cm0"><span class="cfg__t" data-i18n="cfg.compute.cm0" set:html={L('cfg.compute.cm0', lang)}></span><span class="cfg__d">+<span data-usd="40">$40</span></span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-compute" value="cm4"><span class="cfg__t" data-i18n="cfg.compute.cm4" set:html={L('cfg.compute.cm4', lang)}></span><span class="cfg__d">+<span data-usd="95">$95</span></span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-compute" value="cm5"><span class="cfg__t" data-i18n="cfg.compute.cm5" set:html={L('cfg.compute.cm5', lang)}></span><span class="cfg__d">+<span data-usd="105">$105</span></span></label>
          </div>
        </div>
        <div class="cfg__group">
          <div class="cfg__label" data-i18n="cfg.storage" set:html={L('cfg.storage', lang)}></div>
          <div class="cfg__opts">
            <label class="cfg__opt"><input type="radio" name="cfg-storage" value="none" checked><span class="cfg__t" data-i18n="cfg.storage.none" set:html={L('cfg.storage.none', lang)}></span><span class="cfg__d" data-i18n="cfg.delta.0" set:html={L('cfg.delta.0', lang)}></span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-storage" value="tf64"><span class="cfg__t" data-i18n="cfg.storage.tf64" set:html={L('cfg.storage.tf64', lang)}></span><span class="cfg__d">+<span data-usd="19">$19</span></span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-storage" value="ssd128"><span class="cfg__t" data-i18n="cfg.storage.ssd128" set:html={L('cfg.storage.ssd128', lang)}></span><span class="cfg__d">+<span data-usd="25">$25</span></span></label>
          </div>
          <p class="cfg__note" id="cfgNote" style="display:none"></p>
        </div>
        <div class="cfg__bar">
          <div class="cfg__price"><span class="cfg__pl" data-i18n="cfg.total" set:html={L('cfg.total', lang)}></span> <b id="cfgPrice">$119</b><span class="cfg__ship" data-i18n="deck.ship" set:html={L('deck.ship', lang)}></span></div>
          <div class="cta"><button class="btn btn--fill" data-add="typixdeck" data-i18n="deck.add" set:html={L('deck.add', lang)}></button><a class="btn btn--glass" href="#inside" data-i18n="deck.look" set:html={L('deck.look', lang)}></a></div>
        </div>
        <p class="coolnote rise d3" data-i18n="deck.coolnote" set:html={L('deck.coolnote', lang)}></p>
        <div class="trust rise d4"><span class="d"></span> <span data-i18n="deck.trust" set:html={L('deck.trust', lang)}></span></div>
      </div>
    </div>

    <div class="strip rise d4"><div class="in">
      <div class="stat"><div class="n grad">0 dB</div><div class="l" data-i18n="st.fanless" set:html={L('st.fanless', lang)}></div></div>
      <div class="stat"><div class="n grad">6061-T6</div><div class="l" data-i18n="st.alu" set:html={L('st.alu', lang)}></div></div>
      <div class="stat"><div class="n grad">CM4/5/0</div><div class="l" data-i18n="st.pi" set:html={L('st.pi', lang)}></div></div>
      <div class="stat"><div class="n grad">100%</div><div class="l" data-i18n="st.open" set:html={L('st.open', lang)}></div></div>
      <div class="social" data-i18n="st.social" set:html={L('st.social', lang)}></div>
    </div></div>
  </div></header>

  <section id="features"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="f.kicker" set:html={L('f.kicker', lang)}></span><h2 data-i18n="f.title" set:html={L('f.title', lang)}></h2><p data-i18n="f.sub" set:html={L('f.sub', lang)}></p></div>
    <div class="bento">
      <div class="tile tall">
        <div class="ic">▤</div><h3 data-i18n="f.1t" set:html={L('f.1t', lang)}></h3>
        <p data-i18n="f.1p" set:html={L('f.1p', lang)}></p>
        <div class="ph"><img src="/assets/cyberdeck-open.png" alt="CNC aluminum chassis"></div>
      </div>
      <div class="tile wide"><div class="ic">❄</div><h3 data-i18n="f.2t" set:html={L('f.2t', lang)}></h3><p data-i18n="f.2p" set:html={L('f.2p', lang)}></p></div>
      <div class="tile"><div class="ic">▢</div><h3 data-i18n="f.3t" set:html={L('f.3t', lang)}></h3><p data-i18n="f.3p" set:html={L('f.3p', lang)}></p></div>
      <div class="tile"><div class="ic">⎘</div><h3 data-i18n="f.4t" set:html={L('f.4t', lang)}></h3><p data-i18n="f.4p" set:html={L('f.4p', lang)}></p></div>
      <div class="tile"><div class="ic">⚿</div><h3 data-i18n="f.5t" set:html={L('f.5t', lang)}></h3><p data-i18n="f.5p" set:html={L('f.5p', lang)}></p></div>
      <div class="tile wide"><div class="ic">▭</div><h3 data-i18n="f.6t" set:html={L('f.6t', lang)}></h3><p data-i18n="f.6p" set:html={L('f.6p', lang)}></p></div>
    </div>
  </div></section>

  <section class="exploded" id="inside"><div class="wrap in">
    <Viewer3D src="/assets/models/typixdeck.glb" />
    <div>
      <span class="mono" data-i18n="in.kicker" set:html={L('in.kicker', lang)}></span>
      <h2 data-i18n="in.title" set:html={L('in.title', lang)}></h2>
      <ul class="ckl">
        <li><span class="ck">✓</span><span data-i18n="in.1" set:html={L('in.1', lang)}></span></li>
        <li><span class="ck">✓</span><span data-i18n="in.2" set:html={L('in.2', lang)}></span></li>
        <li><span class="ck">✓</span><span data-i18n="in.3" set:html={L('in.3', lang)}></span></li>
        <li><span class="ck">✓</span><span data-i18n="in.4" set:html={L('in.4', lang)}></span></li>
      </ul>
      <a class="btn btn--glass" href="https://github.com/TypixNode" style="margin-top:24px" data-i18n="in.git" set:html={L('in.git', lang)}></a>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="rows">
      <div class="row"><div class="rimg"><img src="/assets/cyberdeck-open.png" alt="Silent desktop"></div>
        <div class="rtxt"><div class="ic" data-i18n="r.1k" set:html={L('r.1k', lang)}></div><h3 data-i18n="r.1t" set:html={L('r.1t', lang)}></h3><p data-i18n="r.1p" set:html={L('r.1p', lang)}></p></div></div>
      <div class="row"><div class="rimg"><img src="/assets/keyboard.jpg" alt="Pocket input"></div>
        <div class="rtxt"><div class="ic" data-i18n="r.2k" set:html={L('r.2k', lang)}></div><h3 data-i18n="r.2t" set:html={L('r.2t', lang)}></h3><p data-i18n="r.2p" set:html={L('r.2p', lang)}></p></div></div>
      <div class="row"><div class="rimg"><img src="/assets/picomac.jpg" alt="For tinkerers"></div>
        <div class="rtxt"><div class="ic" data-i18n="r.3k" set:html={L('r.3k', lang)}></div><h3 data-i18n="r.3t" set:html={L('r.3t', lang)}></h3><p data-i18n="r.3p" set:html={L('r.3p', lang)}></p></div></div>
    </div>
  </div></section>

  <section id="lineup"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="lu.kicker" set:html={L('lu.kicker', lang)}></span><h2 data-i18n="lu.title" set:html={L('lu.title', lang)}></h2><p data-i18n="lu.sub" set:html={L('lu.sub', lang)}></p></div>
    <div class="line">
      <a class="pc" href="/typixdeck"><div class="ph"><img src="/assets/cyberdeck.png" alt="TypixDeck"></div><h3>TypixDeck</h3><p class="ds" data-i18n="p.deck.ds" set:html={L('p.deck.ds', lang)}></p><div class="foot"><span class="pr" data-usd="119">$119</span><button class="add" data-add="typixdeck" aria-label="Add">+</button></div></a>
      <a class="pc" href="/keyboard"><div class="ph"><img src="/assets/keyboard.jpg" alt="BLE Keyboard"></div><h3>BLE Keyboard</h3><p class="ds" data-i18n="p.kb.ds" set:html={L('p.kb.ds', lang)}></p><div class="foot"><span class="pr" data-usd="39">$39</span><button class="add" data-add="keyboard" aria-label="Add">+</button></div></a>
      <a class="pc" href="/diysuite"><div class="ph"><img src="/assets/diysuite.jpg" alt="DIY Suite"></div><h3>DIY Suite</h3><p class="ds" data-i18n="p.diy.ds" set:html={L('p.diy.ds', lang)}></p><div class="foot"><span class="pr" data-usd="9">$9</span><button class="add" data-add="diysuite" aria-label="Add">+</button></div></a>
      <a class="pc" href="/picomac"><div class="ph"><img src="/assets/picomac.jpg" alt="Pico-Mac Nano"></div><h3>Pico-Mac Nano</h3><p class="ds" data-i18n="p.mac.ds" set:html={L('p.mac.ds', lang)}></p><div class="foot"><span class="pr" data-usd="60">$60</span><button class="add" data-add="picomac" aria-label="Add">+</button></div></a>
    </div>
  </div></section>

  <section id="specs"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="sp.kicker" set:html={L('sp.kicker', lang)}></span><h2 data-i18n="sp.title" set:html={L('sp.title', lang)}></h2></div>
    <div class="spectbl">
      <div class="r"><div class="k" data-i18n="sp.compute" set:html={L('sp.compute', lang)}></div><div class="v" data-i18n="sp.compute.v" set:html={L('sp.compute.v', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="sp.chassis" set:html={L('sp.chassis', lang)}></div><div class="v" data-i18n="sp.chassis.v" set:html={L('sp.chassis.v', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="sp.cooling" set:html={L('sp.cooling', lang)}></div><div class="v" data-i18n="sp.cooling.v" set:html={L('sp.cooling.v', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="sp.storage" set:html={L('sp.storage', lang)}></div><div class="v" data-i18n="sp.storage.v" set:html={L('sp.storage.v', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="sp.ports" set:html={L('sp.ports', lang)}></div><div class="v" data-i18n="sp.ports.v" set:html={L('sp.ports.v', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="sp.wireless" set:html={L('sp.wireless', lang)}></div><div class="v" data-i18n="sp.wireless.v" set:html={L('sp.wireless.v', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="sp.dim" set:html={L('sp.dim', lang)}></div><div class="v" data-i18n="sp.dim.v" set:html={L('sp.dim.v', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="sp.os" set:html={L('sp.os', lang)}></div><div class="v" data-i18n="sp.os.v" set:html={L('sp.os.v', lang)}></div></div>
    </div>
  </div></section>

  <section id="faq"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="faq.kicker" set:html={L('faq.kicker', lang)}></span><h2 data-i18n="faq.title" set:html={L('faq.title', lang)}></h2></div>
    <div class="faq">
      <div class="qa"><button><span data-i18n="faq.q1" set:html={L('faq.q1', lang)}></span> <span class="pm">+</span></button><div class="ans"><p data-i18n="faq.a1" set:html={L('faq.a1', lang)}></p></div></div>
      <div class="qa"><button><span data-i18n="faq.q2" set:html={L('faq.q2', lang)}></span> <span class="pm">+</span></button><div class="ans"><p data-i18n="faq.a2" set:html={L('faq.a2', lang)}></p></div></div>
      <div class="qa"><button><span data-i18n="faq.q3" set:html={L('faq.q3', lang)}></span> <span class="pm">+</span></button><div class="ans"><p data-i18n="faq.a3" set:html={L('faq.a3', lang)}></p></div></div>
      <div class="qa"><button><span data-i18n="faq.q4" set:html={L('faq.q4', lang)}></span> <span class="pm">+</span></button><div class="ans"><p data-i18n="faq.a4" set:html={L('faq.a4', lang)}></p></div></div>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="cta.deck.t" set:html={L('cta.deck.t', lang)}></h2>
      <p data-i18n="cta.deck.p" set:html={L('cta.deck.p', lang)}></p>
      <div class="cta"><button class="btn btn--fill" data-add="typixdeck" data-i18n="cart.add" set:html={L('cart.add', lang)}></button><a class="btn btn--glass" href="/products" data-i18n="cta.deck.b2" set:html={L('cta.deck.b2', lang)}></a></div>
    </div>
  </div></section>

  <Footer />
  <CartDrawer />
</Layout>

<style is:global>
  /* ===== Product hero right-column top-gap fix (?fix=fill | ?fix=narrow) =====
     Baseline (.hero with no/other data-fix) is intentionally left untouched:
     .hero uses align-items:center, so the short right .stage centers against
     the tall left .copy and leaves a large gap above it. */

  /* --- fix=fill: top-align the stage and let it grow to fill the column --- */
  .hero[data-fix="fill"]{align-items:stretch}
  .hero[data-fix="fill"] .stage{
    align-self:stretch;           /* match the left column's full height */
    margin-top:0;                 /* sit flush with the copy's top */
    min-height:0;                 /* don't force extra height, let it fill */
  }
  .hero[data-fix="fill"] .stage img{
    max-height:none;              /* allow the image to scale up */
    height:100%;
    width:100%;
    object-fit:contain;
  }
  @media(max-width:900px){
    /* single column on mobile — revert to natural sizing, no forced fill */
    .hero[data-fix="fill"]{align-items:center}
    .hero[data-fix="fill"] .stage{align-self:auto}
    .hero[data-fix="fill"] .stage img{height:auto;max-height:440px}
  }

  /* --- fix=narrow: cap the headline width so the left column is shorter --- */
  .hero[data-fix="narrow"] .copy h1{
    max-width:18ch;               /* fewer chars per line keeps it readable... */
  }
  /* ...but the shorter column would re-introduce a centered gap, so also
     top-align the stage to keep both columns balanced from the top. */
  .hero[data-fix="narrow"]{align-items:start}
  .hero[data-fix="narrow"] .stage{align-self:start;margin-top:0}
  @media(max-width:900px){
    .hero[data-fix="narrow"] .copy h1{max-width:none}
    .hero[data-fix="narrow"]{align-items:center}
  }

  /* ===========================================================================
     CONFIGURATOR LAYOUT — "top image / bottom configurator" (the only layout)
     ---------------------------------------------------------------------------
     The hero has THREE direct children: .copy (chip+h1+lead), .stage (product
     image) and .cfg (grouped option cards + total bar + notes). They stack as a
     centered column: copy → big product image → configurator (two option groups
     side-by-side). The .strip stats bar sits below as a spec bar. Reuses
     --emerald / --teal / --glass / --glassb so it tracks light & dark themes.
     Coexists with ?h (headline) and ?fix (legacy gap fix).
     =========================================================================== */

  /* ---- Configurator card polish ----------------------------------------- */
  .hero .cfg{max-width:none;margin:0}
  .hero .cfg__opt{
    border-radius:14px;
    transition:border-color .16s, background .16s, box-shadow .16s, transform .16s;
  }
  .hero .cfg__opt:hover{border-color:var(--teal);transform:translateY(-1px)}
  .hero .cfg__opt.on{
    border-color:var(--teal);
    background:#0fb88f12;
    box-shadow:0 6px 18px #0a8f6e22;
  }
  /* keep the +price delta hard right-aligned inside each card */
  .hero .cfg__opt .cfg__d{margin-left:auto}
  /* the configurator reads as a soft glass panel around the groups */
  .hero .cfg{
    border:1px solid var(--glassb);
    border-radius:22px;
    background:var(--glass);
    backdrop-filter:blur(14px);
    box-shadow:0 18px 50px #0c1a1614;
    padding:22px 22px 20px;
  }
  .hero .cfg__bar{margin-top:18px}
  .hero .cfg .coolnote{margin:16px 0 0}
  .hero .cfg .trust{margin-top:12px}

  /* ---- Top image / bottom configurator stack ---------------------------- */
  .hero{
    display:flex;
    flex-direction:column;
    gap:26px;
    align-items:stretch;
  }
  .hero .copy{max-width:64ch;margin:0 auto;text-align:center}
  .hero .copy .lead{max-width:none}
  .hero .stage{width:100%}
  .hero .stage img{max-height:460px}
  /* the two option groups sit side-by-side; bar/notes span the full width */
  .hero .cfg{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px 26px;
    align-items:start;
  }
  .hero .cfg__bar,
  .hero .cfg .coolnote,
  .hero .cfg .trust{grid-column:1 / -1}
  /* stats strip below as a spec bar */
  .strip{margin-top:0}
  @media(max-width:720px){
    .hero .cfg{grid-template-columns:1fr}
  }
</style>
