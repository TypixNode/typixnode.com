---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Viewer3D from '../components/Viewer3D.astro';
const links = [
  { href: '#features', key: 'nav.features', label: 'Features' },
  { href: '#inside', key: 'nav.inside', label: 'Inside' },
  { href: '/products', key: 'nav.all', label: 'All products' },
  { href: '#specs', key: 'nav.specs', label: 'Specs' },
  { href: '#faq', key: 'nav.faq', label: 'FAQ' },
];

// Headline A/B variants switchable via ?h=1..6 (1-3 = aluminum craft, 4-6 = hackable/open).
// Falls back to v1 when the param is missing or invalid.
const hRaw = Astro.url.searchParams.get('h');
const hNum = Number(hRaw);
const hVariant = Number.isInteger(hNum) && hNum >= 1 && hNum <= 6 ? hNum : 1;
const h1Key = `deck.h1.v${hVariant}`;

// Hero right-column top-gap fix, switchable via ?fix=fill | ?fix=narrow.
// Anything else (or missing) = baseline (unchanged current behavior).
// Coexists with ?h=1..6, e.g. ?h=2&fix=fill.
const fixRaw = (Astro.url.searchParams.get('fix') || '').toLowerCase();
const heroFix = (fixRaw === 'fill' || fixRaw === 'narrow') ? fixRaw : 'baseline';
---
<Layout
  title="TypixDeck — A fanless Linux computer | TypixNode"
  titleKey="doc.deck"
  description="TypixDeck — a thin, palm-sized fanless Linux computer in a CNC-machined aluminum body, built around a Raspberry Pi Compute Module."
  ogTitle="TypixDeck — A fanless Linux computer"
  ogDescription="A thin, palm-sized fanless Linux computer in a CNC-machined aluminum body, built around a Raspberry Pi Compute Module."
>
  <Nav links={links} buyAdd="typixdeck" />

  <header class="prod" id="buy"><div class="wrap">
    <div class="hero" data-fix={heroFix}>
      <div class="copy">
        <span class="chip rise d1"><span class="d"></span><span class="mono" data-i18n="hero.badge">Compact open hardware · Est. 2026</span></span>
        <h1 class="rise d2" data-i18n={h1Key}>A thin, <span class="grad">palm-sized Linux computer.</span></h1>
        <p class="lead rise d3" data-i18n="deck.lead">Meet TypixDeck — a thin, palm-sized machine in a CNC-machined aluminum body, built around a Raspberry Pi Compute Module. Open it, hack it, make it yours.</p>
      </div>

      <div class="stage rise d4">
        <span class="savebadge r"><span data-i18n="save.title">PRE-ORDER</span><small data-i18n="save.sub"></small></span>
        <span class="pin p1"><div class="k">TypixDeck</div><div class="v" data-i18n="pin.fanless">Raspberry Pi CM0/CM4/CM5</div></span>
        <img src="/assets/cyberdeck.png" alt="TypixDeck — fanless Linux computer">
        <span class="pin p2"><div class="k">0 dB</div><div class="v" data-i18n="pin.silent">Truly silent</div></span>
      </div>

      <div class="cfg rise d3" data-cfg="typixdeck">
        <div class="cfg__group">
          <div class="cfg__label" data-i18n="cfg.compute">Compute</div>
          <div class="cfg__opts">
            <label class="cfg__opt"><input type="radio" name="cfg-compute" value="body" checked><span class="cfg__t" data-i18n="cfg.compute.body">Body only</span><span class="cfg__d" data-i18n="cfg.delta.0">Included</span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-compute" value="cm0"><span class="cfg__t" data-i18n="cfg.compute.cm0">CM0 (soldered CM0→CM4 adapter)</span><span class="cfg__d">+<span data-usd="40">$40</span></span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-compute" value="cm4"><span class="cfg__t" data-i18n="cfg.compute.cm4">CM4 · 4GB · Wi-Fi · no eMMC</span><span class="cfg__d">+<span data-usd="95">$95</span></span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-compute" value="cm5"><span class="cfg__t" data-i18n="cfg.compute.cm5">CM5 · 4GB · Wi-Fi · no eMMC</span><span class="cfg__d">+<span data-usd="105">$105</span></span></label>
          </div>
        </div>
        <div class="cfg__group">
          <div class="cfg__label" data-i18n="cfg.storage">Storage</div>
          <div class="cfg__opts">
            <label class="cfg__opt"><input type="radio" name="cfg-storage" value="none" checked><span class="cfg__t" data-i18n="cfg.storage.none">No TF card</span><span class="cfg__d" data-i18n="cfg.delta.0">Included</span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-storage" value="tf64"><span class="cfg__t" data-i18n="cfg.storage.tf64">SanDisk 64GB · Raspberry Pi OS preloaded</span><span class="cfg__d">+<span data-usd="19">$19</span></span></label>
            <label class="cfg__opt"><input type="radio" name="cfg-storage" value="ssd128"><span class="cfg__t" data-i18n="cfg.storage.ssd128">M.2 SSD 128GB · Toshiba 2230 · OS preloaded</span><span class="cfg__d">+<span data-usd="25">$25</span></span></label>
          </div>
          <p class="cfg__note" id="cfgNote" style="display:none"></p>
        </div>
        <div class="cfg__bar">
          <div class="cfg__price"><span class="cfg__pl" data-i18n="cfg.total">Total</span> <b id="cfgPrice">$119</b><span class="cfg__ship" data-i18n="deck.ship">· shipped worldwide</span></div>
          <div class="cta"><button class="btn btn--fill" data-add="typixdeck" data-i18n="deck.add">Add to cart →</button><a class="btn btn--glass" href="#inside" data-i18n="deck.look">Look inside</a></div>
        </div>
        <p class="coolnote rise d3" data-i18n="deck.coolnote">CM0 / CM4 are fanless &amp; silent (0 dB). The CM5 build adds an optional 4-pin PWM fan + dedicated CNC case — in production.</p>
        <div class="trust rise d4"><span class="d"></span> <span data-i18n="deck.trust">In stock · ships in 2–3 days · 2-year warranty · 4,200+ makers</span></div>
      </div>
    </div>

    <div class="strip rise d4"><div class="in">
      <div class="stat"><div class="n grad">0 dB</div><div class="l" data-i18n="st.fanless">Fanless</div></div>
      <div class="stat"><div class="n grad">6061-T6</div><div class="l" data-i18n="st.alu">CNC aluminum</div></div>
      <div class="stat"><div class="n grad">CM4/5/0</div><div class="l" data-i18n="st.pi">Raspberry Pi</div></div>
      <div class="stat"><div class="n grad">100%</div><div class="l" data-i18n="st.open">Open source</div></div>
      <div class="social" data-i18n="st.social"><b>4,200+</b> makers already build on TypixNode hardware.</div>
    </div></div>
  </div></header>

  <section id="features"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="f.kicker">Why it's different</span><h2 data-i18n="f.title">Everything a tiny computer should be</h2><p data-i18n="f.sub">No fan to fail, no plastic to flex, no firmware locked away — just beautifully made machines you fully control.</p></div>
    <div class="bento">
      <div class="tile tall">
        <div class="ic">▤</div><h3 data-i18n="f.1t">CNC aluminum chassis</h3>
        <p data-i18n="f.1p">Carved from a single block of 6061-T6 aluminum, bead-blasted and anodized. Rigid, cool to the touch, built to last decades.</p>
        <div class="ph"><img src="/assets/cyberdeck-open.png" alt="CNC aluminum chassis"></div>
      </div>
      <div class="tile wide"><div class="ic">❄</div><h3 data-i18n="f.2t">Truly silent — 0 dB</h3><p data-i18n="f.2p">The CNC aluminum chassis is the heatsink — no fan, no vents, no dust. CM0 and CM4 run completely silent at 0 dB. For CM5's extra power, a dedicated CNC case with a 4-pin PWM fan header is in the works.</p></div>
      <div class="tile"><div class="ic">▢</div><h3 data-i18n="f.3t">Raspberry Pi CM4 / CM5</h3><p data-i18n="f.3p">Drop in the compute module you want, upgrade later.</p></div>
      <div class="tile"><div class="ic">⎘</div><h3 data-i18n="f.4t">Full I/O</h3><p data-i18n="f.4p">HDMI, USB-C, dual USB-A, Ethernet, 40-pin GPIO.</p></div>
      <div class="tile"><div class="ic">⚿</div><h3 data-i18n="f.5t">Open CAD &amp; firmware</h3><p data-i18n="f.5p">Every STEP file, schematic and image on GitHub.</p></div>
      <div class="tile wide"><div class="ic">▭</div><h3 data-i18n="f.6t">Credit-card footprint</h3><p data-i18n="f.6p">Smaller than your phone, heavier than it looks. It slips into a bag and runs a full Linux desktop anywhere.</p></div>
    </div>
  </div></section>

  <section class="exploded" id="inside"><div class="wrap in">
    <Viewer3D src="/assets/models/typixdeck.glb" />
    <div>
      <span class="mono" data-i18n="in.kicker">Made to be opened</span>
      <h2 data-i18n="in.title">Four screws and you're inside.</h2>
      <ul class="ckl">
        <li><span class="ck">✓</span><span data-i18n="in.1"><b>Tool-friendly.</b> Captive screws, labeled connectors and a documented teardown — no glue anywhere.</span></li>
        <li><span class="ck">✓</span><span data-i18n="in.2"><b>Swap the brain.</b> The compute module sits on a standard socket. Move up to CM5 in minutes.</span></li>
        <li><span class="ck">✓</span><span data-i18n="in.3"><b>Expand it.</b> M.2 slot for NVMe, a 40-pin header for HATs, internal headers for add-ons.</span></li>
        <li><span class="ck">✓</span><span data-i18n="in.4"><b>Repair, don't replace.</b> Spare parts and CAD are public, so a scratched lid never means a new computer.</span></li>
      </ul>
      <a class="btn btn--glass" href="https://github.com/TypixNode" style="margin-top:24px" data-i18n="in.git">Open CAD on GitHub ↗</a>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="rows">
      <div class="row"><div class="rimg"><img src="/assets/cyberdeck-open.png" alt="Silent desktop"></div>
        <div class="rtxt"><div class="ic" data-i18n="r.1k">Silent desktop</div><h3 data-i18n="r.1t">A full Linux desktop that makes no sound</h3><p data-i18n="r.1p">Boot straight into Raspberry Pi OS or your distro of choice. Code, SSH, browse and tinker — with zero fan noise on your desk.</p></div></div>
      <div class="row"><div class="rimg"><img src="/assets/keyboard.jpg" alt="Pocket input"></div>
        <div class="rtxt"><div class="ic" data-i18n="r.2k">Pocket input</div><h3 data-i18n="r.2t">Pairs with a card-sized keyboard</h3><p data-i18n="r.2p">Add the TypixNode BLE Keyboard for a complete pocket workstation — full layout, gyro air-mouse and white backlight over Bluetooth or USB-C.</p></div></div>
      <div class="row"><div class="rimg"><img src="/assets/picomac.jpg" alt="For tinkerers"></div>
        <div class="rtxt"><div class="ic" data-i18n="r.3k">For tinkerers</div><h3 data-i18n="r.3t">Hardware that invites curiosity</h3><p data-i18n="r.3p">From a palm-sized 1984 Mac to a solder-it-yourself keyboard kit, every TypixNode device is designed to be opened, understood and modified.</p></div></div>
    </div>
  </div></section>

  <section id="lineup"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="lu.kicker">The full lineup</span><h2 data-i18n="lu.title">Four machines. Pick your size.</h2><p data-i18n="lu.sub">A small, carefully made catalogue — no filler, every product is something we'd carry ourselves.</p></div>
    <div class="line">
      <a class="pc" href="/typixdeck"><div class="ph"><img src="/assets/cyberdeck.png" alt="TypixDeck"></div><h3>TypixDeck</h3><p class="ds" data-i18n="p.deck.ds">CNC-aluminum Linux computer with a Raspberry Pi Compute Module.</p><div class="foot"><span class="pr" data-usd="119">$119</span><button class="add" data-add="typixdeck" aria-label="Add">+</button></div></a>
      <a class="pc" href="/keyboard"><div class="ph"><img src="/assets/keyboard.jpg" alt="BLE Keyboard"></div><h3>BLE Keyboard</h3><p class="ds" data-i18n="p.kb.ds">Card-sized full keyboard with gyro air-mouse and backlight. BT 5.2 / USB-C.</p><div class="foot"><span class="pr" data-usd="39">$39</span><button class="add" data-add="keyboard" aria-label="Add">+</button></div></a>
      <a class="pc" href="/diysuite"><div class="ph"><img src="/assets/diysuite.jpg" alt="DIY Suite"></div><h3>DIY Suite</h3><p class="ds" data-i18n="p.diy.ds">Solder your own 48-key keyboard in an afternoon. Open PCB + QMK firmware.</p><div class="foot"><span class="pr" data-usd="9">$9</span><button class="add" data-add="diysuite" aria-label="Add">+</button></div></a>
      <a class="pc" href="/picomac"><div class="ph"><img src="/assets/picomac.jpg" alt="Pico-Mac Nano"></div><h3>Pico-Mac Nano</h3><p class="ds" data-i18n="p.mac.ds">A 1984 Macintosh shrunk to your palm. Boots real classic Mac OS over USB-C.</p><div class="foot"><span class="pr" data-usd="60">$60</span><button class="add" data-add="picomac" aria-label="Add">+</button></div></a>
    </div>
  </div></section>

  <section id="specs"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="sp.kicker">TypixDeck</span><h2 data-i18n="sp.title">Technical specifications</h2></div>
    <div class="spectbl">
      <div class="r"><div class="k" data-i18n="sp.compute">Compute</div><div class="v" data-i18n="sp.compute.v">Raspberry Pi Compute Module 4 or 5 (socketed)</div></div>
      <div class="r"><div class="k" data-i18n="sp.chassis">Chassis</div><div class="v" data-i18n="sp.chassis.v">CNC-milled 6061-T6 aluminum, bead-blasted &amp; anodized</div></div>
      <div class="r"><div class="k" data-i18n="sp.cooling">Cooling</div><div class="v" data-i18n="sp.cooling.v">Passive 0 dB on CM0/CM4 (chassis is the heatsink); CM5 adds an optional 4-pin PWM fan header + dedicated CNC case (in development)</div></div>
      <div class="r"><div class="k" data-i18n="sp.storage">Storage</div><div class="v" data-i18n="sp.storage.v">microSD + internal M.2 NVMe slot</div></div>
      <div class="r"><div class="k" data-i18n="sp.ports">Ports</div><div class="v" data-i18n="sp.ports.v">HDMI, USB-C (PD), 2× USB-A, Gigabit Ethernet, 40-pin GPIO</div></div>
      <div class="r"><div class="k" data-i18n="sp.wireless">Wireless</div><div class="v" data-i18n="sp.wireless.v">Wi-Fi 5 / Bluetooth 5.0 (CM-dependent)</div></div>
      <div class="r"><div class="k" data-i18n="sp.dim">Dimensions</div><div class="v" data-i18n="sp.dim.v">95 × 62 × 22 mm · 280 g</div></div>
      <div class="r"><div class="k" data-i18n="sp.os">Open source</div><div class="v" data-i18n="sp.os.v">Full STEP files, schematics &amp; firmware on GitHub</div></div>
    </div>
  </div></section>

  <section id="faq"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="faq.kicker">Good to know</span><h2 data-i18n="faq.title">Frequently asked questions</h2></div>
    <div class="faq">
      <div class="qa"><button><span data-i18n="faq.q1">Does it come with a Raspberry Pi Compute Module?</span> <span class="pm">+</span></button><div class="ans"><p data-i18n="faq.a1">The TypixDeck ships as a chassis kit. Add a CM4 or CM5 at checkout, or drop in one you already own — it uses the standard compute-module socket.</p></div></div>
      <div class="qa"><button><span data-i18n="faq.q2">How does a fanless computer stay cool?</span> <span class="pm">+</span></button><div class="ans"><p data-i18n="faq.a2">The CNC aluminum chassis is the heatsink. The compute module is thermally bonded to the chassis, so heat spreads across the whole body and dissipates silently, even under sustained load.</p></div></div>
      <div class="qa"><button><span data-i18n="faq.q3">Can I really open and repair it myself?</span> <span class="pm">+</span></button><div class="ans"><p data-i18n="faq.a3">Yes. Four captive screws, no glue, labeled connectors, and a public teardown guide. Spare parts and CAD files are available so you can repair or modify anything.</p></div></div>
      <div class="qa"><button><span data-i18n="faq.q4">Do you ship worldwide?</span> <span class="pm">+</span></button><div class="ans"><p data-i18n="faq.a4">Yes — free worldwide shipping, typically 2–3 business days handling plus carrier transit. Duties may apply depending on your region.</p></div></div>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="cta.deck.t">Build your pocket Linux lab</h2>
      <p data-i18n="cta.deck.p">Silent, open, and made to be opened. Join 4,200+ makers running TypixNode hardware.</p>
      <div class="cta"><button class="btn btn--fill" data-add="typixdeck" data-i18n="cart.add">Add to cart</button><a class="btn btn--glass" href="/products" data-i18n="cta.deck.b2">See all products</a></div>
    </div>
  </div></section>

  <Footer />
  <CartDrawer />
</Layout>

<style is:global>
  /* ===== Product hero right-column top-gap fix (?fix=fill | ?fix=narrow) =====
     Baseline (.hero with no/other data-fix) is intentionally left untouched:
     .hero uses align-items:center, so the short right .stage centers against
     the tall left .copy and leaves a large gap above it. */

  /* --- fix=fill: top-align the stage and let it grow to fill the column --- */
  .hero[data-fix="fill"]{align-items:stretch}
  .hero[data-fix="fill"] .stage{
    align-self:stretch;           /* match the left column's full height */
    margin-top:0;                 /* sit flush with the copy's top */
    min-height:0;                 /* don't force extra height, let it fill */
  }
  .hero[data-fix="fill"] .stage img{
    max-height:none;              /* allow the image to scale up */
    height:100%;
    width:100%;
    object-fit:contain;
  }
  @media(max-width:900px){
    /* single column on mobile — revert to natural sizing, no forced fill */
    .hero[data-fix="fill"]{align-items:center}
    .hero[data-fix="fill"] .stage{align-self:auto}
    .hero[data-fix="fill"] .stage img{height:auto;max-height:440px}
  }

  /* --- fix=narrow: cap the headline width so the left column is shorter --- */
  .hero[data-fix="narrow"] .copy h1{
    max-width:18ch;               /* fewer chars per line keeps it readable... */
  }
  /* ...but the shorter column would re-introduce a centered gap, so also
     top-align the stage to keep both columns balanced from the top. */
  .hero[data-fix="narrow"]{align-items:start}
  .hero[data-fix="narrow"] .stage{align-self:start;margin-top:0}
  @media(max-width:900px){
    .hero[data-fix="narrow"] .copy h1{max-width:none}
    .hero[data-fix="narrow"]{align-items:center}
  }

  /* ===========================================================================
     CONFIGURATOR LAYOUT — "top image / bottom configurator" (the only layout)
     ---------------------------------------------------------------------------
     The hero has THREE direct children: .copy (chip+h1+lead), .stage (product
     image) and .cfg (grouped option cards + total bar + notes). They stack as a
     centered column: copy → big product image → configurator (two option groups
     side-by-side). The .strip stats bar sits below as a spec bar. Reuses
     --emerald / --teal / --glass / --glassb so it tracks light & dark themes.
     Coexists with ?h (headline) and ?fix (legacy gap fix).
     =========================================================================== */

  /* ---- Configurator card polish ----------------------------------------- */
  .hero .cfg{max-width:none;margin:0}
  .hero .cfg__opt{
    border-radius:14px;
    transition:border-color .16s, background .16s, box-shadow .16s, transform .16s;
  }
  .hero .cfg__opt:hover{border-color:var(--teal);transform:translateY(-1px)}
  .hero .cfg__opt.on{
    border-color:var(--teal);
    background:#0fb88f12;
    box-shadow:0 6px 18px #0a8f6e22;
  }
  /* keep the +price delta hard right-aligned inside each card */
  .hero .cfg__opt .cfg__d{margin-left:auto}
  /* the configurator reads as a soft glass panel around the groups */
  .hero .cfg{
    border:1px solid var(--glassb);
    border-radius:22px;
    background:var(--glass);
    backdrop-filter:blur(14px);
    box-shadow:0 18px 50px #0c1a1614;
    padding:22px 22px 20px;
  }
  .hero .cfg__bar{margin-top:18px}
  .hero .cfg .coolnote{margin:16px 0 0}
  .hero .cfg .trust{margin-top:12px}

  /* ---- Top image / bottom configurator stack ---------------------------- */
  .hero{
    display:flex;
    flex-direction:column;
    gap:26px;
    align-items:stretch;
  }
  .hero .copy{max-width:64ch;margin:0 auto;text-align:center}
  .hero .copy .lead{max-width:none}
  .hero .stage{width:100%}
  .hero .stage img{max-height:460px}
  /* the two option groups sit side-by-side; bar/notes span the full width */
  .hero .cfg{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px 26px;
    align-items:start;
  }
  .hero .cfg__bar,
  .hero .cfg .coolnote,
  .hero .cfg .trust{grid-column:1 / -1}
  /* stats strip below as a spec bar */
  .strip{margin-top:0}
  @media(max-width:720px){
    .hero .cfg{grid-template-columns:1fr}
  }
</style>
