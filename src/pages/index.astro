---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';

// Grayscale brand marks live in /public/assets/compat as monochrome PNGs,
// generated from official logos so the wall reads like one cohesive set.
const compatGroups = [
  {
    titleKey: 'compat.g.os',
    fallback: 'Operating systems',
    items: [
      { slug: 'raspberry-pi-os', name: 'Raspberry Pi OS' },
      { slug: 'debian', name: 'Debian' },
      { slug: 'ubuntu', name: 'Ubuntu' },
      { slug: 'arch-linux', name: 'Arch Linux ARM' },
      { slug: 'kali-linux', name: 'Kali Linux' },
      { slug: 'freebsd', name: 'FreeBSD' },
    ],
  },
  {
    titleKey: 'compat.g.emu',
    fallback: 'Retro gaming & emulators',
    items: [
      { slug: 'retroarch', name: 'RetroArch' },
      { slug: 'dosbox', name: 'DOSBox' },
      { slug: 'ppsspp', name: 'PPSSPP · PSP' },
      { slug: 'nestopia', name: 'Nestopia · FC/NES' },
      { slug: 'mgba', name: 'mGBA · GBA' },
      { slug: 'dolphin', name: 'Dolphin · GC/Wii' },
      { slug: 'arduboy', name: 'Arduboy' },
      { slug: 'scummvm', name: 'ScummVM' },
      { slug: 'tic80', name: 'TIC-80' },
    ],
  },
  {
    titleKey: 'compat.g.engine',
    fallback: 'Game engines & creation',
    items: [
      { slug: 'godot', name: 'Godot' },
      { slug: 'love2d', name: 'LÖVE2D' },
      { slug: 'raylib', name: 'Raylib' },
      { slug: 'processing', name: 'Processing' },
    ],
  },
  {
    titleKey: 'compat.g.desktop',
    fallback: 'Languages & development',
    items: [
      { slug: 'claude-code', name: 'Claude Code' },
      { slug: 'c', name: 'C' },
      { slug: 'cpp', name: 'C++' },
      { slug: 'python', name: 'Python' },
      { slug: 'lua', name: 'Lua' },
      { slug: 'go', name: 'Go' },
      { slug: 'nodejs', name: 'Node.js' },
      { slug: 'rust', name: 'Rust' },
      { slug: 'openjdk', name: 'OpenJDK' },
      { slug: 'dotnet', name: '.NET' },
      { slug: 'arduino', name: 'Arduino' },
      { slug: 'neovim', name: 'Neovim' },
      { slug: 'vim', name: 'Vim' },
      { slug: 'git', name: 'git' },
      { slug: 'chromium', name: 'Chromium' },
    ],
  },
  {
    titleKey: 'compat.g.media',
    fallback: 'Media & office',
    items: [
      { slug: 'vlc', name: 'VLC' },
      { slug: 'mpv', name: 'mpv' },
      { slug: 'obs', name: 'OBS' },
      { slug: 'libreoffice', name: 'LibreOffice' },
      { slug: 'latex', name: 'LaTeX' },
    ],
  },
];
---
<Layout
  title="TypixNode — Compact Open Hardware"
  titleKey="doc.home"
  description="TypixNode builds compact open hardware — a CNC-aluminum Linux computer, a card-sized keyboard, and a palm-sized Macintosh. Open-source, shipped worldwide."
>
  <Nav />

  <div class="home-root">

  <header class="home"><div class="wrap">
    <div class="hero-copy">
      <span class="chip rise d1"><span class="d"></span><span class="mono" data-i18n="hero.badge" set:html={L('hero.badge', lang)}></span></span>
      <h1 class="rise d2" data-i18n="home.h1" set:html={L('home.h1', lang)}></h1>
      <p class="lead rise d3" data-i18n="home.lead" set:html={L('home.lead', lang)}></p>
      <div class="cta rise d3"><a class="btn btn--fill" href="/typixdeck" data-i18n="home.cta1" set:html={L('home.cta1', lang)}></a><a class="btn btn--glass cta2" href="/products" data-i18n="home.cta2" set:html={L('home.cta2', lang)}></a></div>
    </div>
    <div class="stage home rise d4">
      <span class="savebadge"><span data-i18n="save.title" set:html={L('save.title', lang)}></span><small data-i18n="save.sub" set:html={L('save.sub', lang)}></small></span>
      <span class="pin p1"><div class="k">TypixDeck</div><div class="v" data-i18n="pin.fanless" set:html={L('pin.fanless', lang)}></div></span>
      <a href="/typixdeck"><img src="/assets/cyberdeck.png" alt="TypixDeck — fanless Linux computer"></a>
      <span class="pin p2"><div class="k"><span data-usd="119">$119</span></div><div class="v" data-i18n="pin.stock" set:html={L('pin.stock', lang)}></div></span>
    </div>
  </div></header>

  <section id="products"><div class="wrap">
    <div class="shead">
      <div class="ttl"><span class="mono" data-i18n="prod.kicker" set:html={L('prod.kicker', lang)}></span><h2 data-i18n="prod.title" set:html={L('prod.title', lang)}></h2><p data-i18n="prod.sub" set:html={L('prod.sub', lang)}></p></div>
      <a class="hint" href="/products"><span data-i18n="see.all" set:html={L('see.all', lang)}></span> <span class="ar">→</span></a>
    </div>
  </div>
  <div class="wrap">
    <div class="scroller">
      <a class="pc" href="/typixdeck"><div class="ph"><span class="tag" data-i18n="tag.flagship" set:html={L('tag.flagship', lang)}></span><img src="/assets/cyberdeck.png" alt="TypixDeck"></div><h3>TypixDeck</h3><p class="ds" data-i18n="p.deck.ds" set:html={L('p.deck.ds', lang)}></p><div class="foot"><span class="pr" data-usd="119">$119</span><button class="add" data-add="typixdeck" aria-label="Add">+</button></div></a>
      <a class="pc" href="/keyboard"><div class="ph"><img src="/assets/keyboard.jpg" alt="BLE Keyboard"></div><h3>BLE Keyboard</h3><p class="ds" data-i18n="p.kb.ds" set:html={L('p.kb.ds', lang)}></p><div class="foot"><span class="pr" data-usd="39">$39</span><button class="add" data-add="keyboard" aria-label="Add">+</button></div></a>
      <a class="pc" href="/diysuite"><div class="ph"><img src="/assets/diysuite.jpg" alt="DIY Suite"></div><h3>DIY Suite</h3><p class="ds" data-i18n="p.diy.ds" set:html={L('p.diy.ds', lang)}></p><div class="foot"><span class="pr" data-usd="9">$9</span><button class="add" data-add="diysuite" aria-label="Add">+</button></div></a>
      <a class="pc" href="/picomac"><div class="ph"><img src="/assets/picomac.jpg" alt="Pico-Mac Nano"></div><h3>Pico-Mac Nano</h3><p class="ds" data-i18n="p.mac.ds" set:html={L('p.mac.ds', lang)}></p><div class="foot"><span class="pr" data-usd="60">$60</span><button class="add" data-add="picomac" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><span class="tag" data-i18n="tag.new" set:html={L('tag.new', lang)}></span><img src="/assets/cm0-adapter.png" alt="CM0→CM4 adapter (CM0 soldered)"></div><h3>CM0 Adapter</h3><p class="ds" data-i18n="p.cm0adp.ds" set:html={L('p.cm0adp.ds', lang)}></p><div class="foot"><span class="pr" data-usd="40">$40</span><button class="add" data-add="cm0-adapter" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><img src="/assets/cm0-module.jpeg" alt="CM0 module"></div><h3>CM0 Module</h3><p class="ds" data-i18n="p.cm0.ds" set:html={L('p.cm0.ds', lang)}></p><div class="foot"><span class="pr" data-usd="30">$30</span><button class="add" data-add="cm0-module" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><img src="/assets/cm0-adapter-raw.png" alt="CM0→CM4 adapter bare board"></div><h3>CM0 Adapter (bare)</h3><p class="ds" data-i18n="p.cm0raw.ds" set:html={L('p.cm0raw.ds', lang)}></p><div class="foot"><span class="pr" data-usd="10">$10</span><button class="add" data-add="cm0-adapter-raw" aria-label="Add">+</button></div></a>
    </div>
  </div></section>

  <section id="why"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="why.kicker" set:html={L('why.kicker', lang)}></span><h2 data-i18n="why.title" set:html={L('why.title', lang)}></h2></div>
    <div class="feat">
      <div class="c"><div class="ic">❄</div><h4 data-i18n="why.1t" set:html={L('why.1t', lang)}></h4><p data-i18n="why.1p" set:html={L('why.1p', lang)}></p></div>
      <div class="c"><div class="ic">⚿</div><h4 data-i18n="why.2t" set:html={L('why.2t', lang)}></h4><p data-i18n="why.2p" set:html={L('why.2p', lang)}></p></div>
      <div class="c"><div class="ic">▭</div><h4 data-i18n="why.3t" set:html={L('why.3t', lang)}></h4><p data-i18n="why.3p" set:html={L('why.3p', lang)}></p></div>
    </div>
  </div></section>

  <section id="compat"><div class="wrap">
    <div class="head">
      <span class="mono" data-i18n="compat.kicker" set:html={L('compat.kicker', lang)}></span>
      <h2 data-i18n="compat.title" set:html={L('compat.title', lang)}></h2>
      <p class="compat-sub" data-i18n="compat.sub" set:html={L('compat.sub', lang)}></p>
    </div>

    <div class="compat-grid">
      {compatGroups.map((group) => (
        <div class="compat-group">
          <h3 data-i18n={group.titleKey} set:html={L(group.titleKey, lang)}></h3>
          <ul class="compat-items">
            {group.items.map((item) => (
              <li title={item.name}>
                <span class="ci"><img src={`/assets/compat/${item.slug}.png`} alt={item.name} loading="lazy" decoding="async" width="40" height="40" /></span>
                <span>{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="compat-disclaimer" data-i18n="compat.disc" set:html={L('compat.disc', lang)}></p>
  </div></section>

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="cta.home.t" set:html={L('cta.home.t', lang)}></h2>
      <p data-i18n="cta.home.p" set:html={L('cta.home.p', lang)}></p>
      <div class="cta"><a class="btn btn--fill" href="/typixdeck" data-i18n="cta.home.b1" set:html={L('cta.home.b1', lang)}></a><a class="btn btn--glass" href="/products" data-i18n="cta.home.b2" set:html={L('cta.home.b2', lang)}></a></div>
    </div>
  </div></section>

  </div>

  <Footer />
  <CartDrawer />
</Layout>

<style is:global>
  /* ===== Homepage hero — finalized layout: left text / right image =====
     The default markup renders the hero copy on the left and the product
     stage on the right. This restructures only the hero visuals; i18n,
     cart, 3D viewer, nav and Lineup are untouched. */
  .home-root .hero-copy{display:contents}

  .home-root header.home{text-align:left;padding:48px 0 24px}
  /* Hero: wide left copy + image pulled close (tight 14px gap), columns
     vertically centered so the product image is centered against the copy. */
  .home-root header.home .wrap{
    display:grid;grid-template-columns:1.5fr 1fr;gap:14px;align-items:center}
  .home-root .hero-copy{display:flex;flex-direction:column;align-items:flex-start}
  .home-root header.home .lead{margin-left:0;margin-right:0;max-width:54ch}
  .home-root header.home .cta{justify-content:flex-start}
  /* Main title sized so the Chinese headline doesn't wrap so much. */
  .home-root header.home h1{font-size:clamp(2.4rem,6.1vw,4.2rem)}
  /* No top/bottom margin override — let align-items:center vertically center
     the product image against the (taller) copy column. */
  .home-root .stage.home{max-width:none;width:100%;align-self:center}

  @media(max-width:900px){
    .home-root header.home .wrap{grid-template-columns:1fr;gap:24px}
    .home-root .stage.home{margin-top:8px}
  }

  /* ===== Software & compatibility wall — grayscale brand-mark grid ===== */
  #compat .compat-sub{max-width:62ch;margin:10px auto 0;opacity:.78}
  #compat .head{margin-bottom:32px}
  .compat-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:24px}
  .compat-group{
    border:1px solid var(--line2);
    border-radius:18px;padding:22px 20px 24px;
    background:linear-gradient(180deg,color-mix(in srgb,var(--glass) 84%,transparent),color-mix(in srgb,var(--glass) 58%,transparent));
    box-shadow:inset 0 1px 0 rgba(255,255,255,.045)}
  .compat-group h3{
    font-size:.82rem;letter-spacing:.04em;text-transform:uppercase;
    margin:0 0 18px;color:var(--soft);font-weight:600}
  .compat-items{
    list-style:none;margin:0;padding:0;
    display:grid;grid-template-columns:repeat(auto-fit,minmax(82px,1fr));
    gap:20px 14px}
  .compat-items li{
    display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:9px;
    min-height:80px;text-align:center;
    font-size:.76rem;line-height:1.18;color:var(--soft);
    overflow-wrap:anywhere}
  .compat-items .ci{
    flex:0 0 auto;width:44px;height:44px;
    display:grid;place-items:center}
  .compat-items .ci img{
    width:40px;height:40px;object-fit:contain;
    opacity:.8;transition:opacity .15s ease,transform .15s ease}
  .compat-items li:hover .ci img{opacity:1;transform:translateY(-1px)}
  .compat-items li:hover{color:var(--ink)}
  .compat-disclaimer{
    margin-top:26px;text-align:center;
    font-size:.74rem;color:var(--soft2);line-height:1.5}

  @media(max-width:520px){
    .compat-grid{grid-template-columns:1fr}
    .compat-items{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px 10px}
  }
</style>
