---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';

// Homepage uses a single finalized layout: left text / right image (formerly layout "b").
---
<Layout
  title="TypixNode — Compact Open Hardware"
  titleKey="doc.home"
  description="TypixNode builds compact open hardware — a CNC-aluminum Linux computer, a card-sized keyboard, and a palm-sized Macintosh. Open-source, shipped worldwide."
>
  <Nav />

  <div class="home-root">

  <header class="home"><div class="wrap">
    <div class="hero-copy">
      <span class="chip rise d1"><span class="d"></span><span class="mono" data-i18n="hero.badge">Compact open hardware · Est. 2026</span></span>
      <h1 class="rise d2" data-i18n="home.h1">A complete computer,<br/>the size of <span class="grad">your palm.</span></h1>
      <p class="lead rise d3" data-i18n="home.lead">A small, carefully made family of machines — the CNC-aluminum TypixDeck, a card-sized keyboard, and a wearable Macintosh. Open-source, shipped worldwide.</p>
      <div class="cta rise d3"><a class="btn btn--fill" href="/typixdeck" data-i18n="home.cta1">Meet TypixDeck →</a><a class="btn btn--glass cta2" href="/products" data-i18n="home.cta2">Browse all products</a></div>
    </div>
    <div class="stage home rise d4">
      <span class="savebadge"><span data-i18n="save.title">PRE-ORDER</span><small data-i18n="save.sub"></small></span>
      <span class="pin p1"><div class="k">TypixDeck</div><div class="v" data-i18n="pin.fanless">Raspberry Pi CM0/CM4/CM5</div></span>
      <a href="/typixdeck"><img src="/assets/cyberdeck.png" alt="TypixDeck — fanless Linux computer"></a>
      <span class="pin p2"><div class="k"><span data-usd="119">$119</span></div><div class="v" data-i18n="pin.stock">In stock</div></span>
    </div>
  </div></header>

  <section id="products"><div class="wrap">
    <div class="shead">
      <div class="ttl"><span class="mono" data-i18n="prod.kicker">The catalogue</span><h2 data-i18n="prod.title">All products</h2><p data-i18n="prod.sub">Four machines · open-source · shipped worldwide</p></div>
      <a class="hint" href="/products"><span data-i18n="see.all">See all products</span> <span class="ar">→</span></a>
    </div>
  </div>
  <div class="wrap">
    <div class="scroller">
      <a class="pc" href="/typixdeck"><div class="ph"><span class="tag" data-i18n="tag.flagship">Flagship</span><img src="/assets/cyberdeck.png" alt="TypixDeck"></div><h3>TypixDeck</h3><p class="ds" data-i18n="p.deck.ds">CNC-aluminum Linux computer with a Raspberry Pi Compute Module. Silent, sealed, open.</p><div class="foot"><span class="pr" data-usd="119">$119</span><button class="add" data-add="typixdeck" aria-label="Add">+</button></div></a>
      <a class="pc" href="/keyboard"><div class="ph"><img src="/assets/keyboard.jpg" alt="BLE Keyboard"></div><h3>BLE Keyboard</h3><p class="ds" data-i18n="p.kb.ds">Card-sized full keyboard with gyro air-mouse and white backlight. Bluetooth 5.2 or USB-C.</p><div class="foot"><span class="pr" data-usd="39">$39</span><button class="add" data-add="keyboard" aria-label="Add">+</button></div></a>
      <a class="pc" href="/diysuite"><div class="ph"><img src="/assets/diysuite.jpg" alt="DIY Suite"></div><h3>DIY Suite</h3><p class="ds" data-i18n="p.diy.ds">Solder your own 48-key keyboard in an afternoon. Open-source PCB and QMK firmware.</p><div class="foot"><span class="pr" data-usd="9">$9</span><button class="add" data-add="diysuite" aria-label="Add">+</button></div></a>
      <a class="pc" href="/picomac"><div class="ph"><img src="/assets/picomac.jpg" alt="Pico-Mac Nano"></div><h3>Pico-Mac Nano</h3><p class="ds" data-i18n="p.mac.ds">A 1984 Macintosh shrunk to your palm. Boots real classic Mac OS over USB-C.</p><div class="foot"><span class="pr" data-usd="60">$60</span><button class="add" data-add="picomac" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><span class="tag" data-i18n="tag.new">New</span><img src="/assets/cm0-adapter.png" alt="CM0→CM4 adapter (CM0 soldered)"></div><h3>CM0 Adapter</h3><p class="ds" data-i18n="p.cm0adp.ds">CM0 pre-soldered on a CM0→CM4 adapter. Drops straight into any CM4 socket.</p><div class="foot"><span class="pr" data-usd="40">$40</span><button class="add" data-add="cm0-adapter" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><img src="/assets/cm0-module.jpeg" alt="CM0 module"></div><h3>CM0 Module</h3><p class="ds" data-i18n="p.cm0.ds">Standalone CM0 compute module — castellated 132-pin, for your own adapter or board.</p><div class="foot"><span class="pr" data-usd="30">$30</span><button class="add" data-add="cm0-module" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><img src="/assets/cm0-adapter-raw.png" alt="CM0→CM4 adapter bare board"></div><h3>CM0 Adapter (bare)</h3><p class="ds" data-i18n="p.cm0raw.ds">Bare CM0→CM4 adapter PCB. Solder your own CM0 and go.</p><div class="foot"><span class="pr" data-usd="10">$10</span><button class="add" data-add="cm0-adapter-raw" aria-label="Add">+</button></div></a>
    </div>
  </div></section>

  <section id="why"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="why.kicker">Why TypixNode</span><h2 data-i18n="why.title">Built small. Built open.</h2></div>
    <div class="feat">
      <div class="c"><div class="ic">❄</div><h4 data-i18n="why.1t">Fanless &amp; silent</h4><p data-i18n="why.1p">CNC aluminum bodies double as heatsinks — full performance at 0 dB, no fans to fail.</p></div>
      <div class="c"><div class="ic">⚿</div><h4 data-i18n="why.2t">Fully open source</h4><p data-i18n="why.2p">Schematics, firmware and STEP files are all public, so you can repair, mod and build on everything.</p></div>
      <div class="c"><div class="ic">▭</div><h4 data-i18n="why.3t">Pocket-sized</h4><p data-i18n="why.3p">From a palm computer to a card-sized keyboard, every device is made to travel with you.</p></div>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="cta.home.t">Start with TypixDeck</h2>
      <p data-i18n="cta.home.p">A silent, open, CNC-aluminum Linux computer that fits in your hand. Join 4,200+ makers.</p>
      <div class="cta"><a class="btn btn--fill" href="/typixdeck" data-i18n="cta.home.b1">Meet TypixDeck</a><a class="btn btn--glass" href="/products" data-i18n="cta.home.b2">See all products</a></div>
    </div>
  </div></section>

  </div>

  <Footer />
  <CartDrawer />
</Layout>

<style is:global>
  /* ===== Homepage hero — finalized layout: left text / right image =====
     The default markup renders the hero copy on the left and the product
     stage on the right. This restructures only the hero visuals; i18n,
     cart, 3D viewer, nav and Lineup are untouched. */
  .home-root .hero-copy{display:contents}

  .home-root header.home{text-align:left;padding:48px 0 24px}
  .home-root header.home .wrap{
    display:grid;grid-template-columns:1.18fr .82fr;gap:28px;align-items:center}
  .home-root .hero-copy{display:flex;flex-direction:column;align-items:flex-start}
  .home-root header.home .lead{margin-left:0;margin-right:0;max-width:46ch}
  .home-root header.home .cta{justify-content:flex-start}
  /* Main title one notch down so the Chinese headline doesn't wrap so much. */
  .home-root header.home h1{font-size:clamp(2.4rem,6.1vw,4.7rem)}
  .home-root .stage.home{margin:0;max-width:none;width:100%}
  @media(max-width:900px){
    .home-root header.home .wrap{grid-template-columns:1fr;gap:28px}
    .home-root .stage.home{margin-top:8px}
  }
</style>
