---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
---
<Layout
  title="TypixNode — Compact Open Hardware"
  titleKey="doc.home"
  description="TypixNode builds compact open hardware — a CNC-aluminum Linux computer, a card-sized keyboard, and a palm-sized Macintosh. Open-source, shipped worldwide."
>
  <Nav />

  <div class="home-root">

  <header class="home"><div class="wrap">
    <div class="hero-copy">
      <span class="chip rise d1"><span class="d"></span><span class="mono" data-i18n="hero.badge">Compact open hardware · Est. 2026</span></span>
      <h1 class="rise d2" data-i18n="home.h1">A complete computer,<br/>the size of <span class="grad">your palm.</span></h1>
      <p class="lead rise d3" data-i18n="home.lead">A small, carefully made family of machines — the CNC-aluminum TypixDeck, a card-sized keyboard, and a wearable Macintosh. Open-source, shipped worldwide.</p>
      <div class="cta rise d3"><a class="btn btn--fill" href="/typixdeck" data-i18n="home.cta1">Meet TypixDeck →</a><a class="btn btn--glass cta2" href="/products" data-i18n="home.cta2">Browse all products</a></div>
    </div>
    <div class="stage home rise d4">
      <span class="savebadge"><span data-i18n="save.title">PRE-ORDER</span><small data-i18n="save.sub"></small></span>
      <span class="pin p1"><div class="k">TypixDeck</div><div class="v" data-i18n="pin.fanless">Raspberry Pi CM0/CM4/CM5</div></span>
      <a href="/typixdeck"><img src="/assets/cyberdeck.png" alt="TypixDeck — fanless Linux computer"></a>
      <span class="pin p2"><div class="k"><span data-usd="119">$119</span></div><div class="v" data-i18n="pin.stock">In stock</div></span>
    </div>
  </div></header>

  <section id="products"><div class="wrap">
    <div class="shead">
      <div class="ttl"><span class="mono" data-i18n="prod.kicker">The catalogue</span><h2 data-i18n="prod.title">All products</h2><p data-i18n="prod.sub">Four machines · open-source · shipped worldwide</p></div>
      <a class="hint" href="/products"><span data-i18n="see.all">See all products</span> <span class="ar">→</span></a>
    </div>
  </div>
  <div class="wrap">
    <div class="scroller">
      <a class="pc" href="/typixdeck"><div class="ph"><span class="tag" data-i18n="tag.flagship">Flagship</span><img src="/assets/cyberdeck.png" alt="TypixDeck"></div><h3>TypixDeck</h3><p class="ds" data-i18n="p.deck.ds">CNC-aluminum Linux computer with a Raspberry Pi Compute Module. Silent, sealed, open.</p><div class="foot"><span class="pr" data-usd="119">$119</span><button class="add" data-add="typixdeck" aria-label="Add">+</button></div></a>
      <a class="pc" href="/keyboard"><div class="ph"><img src="/assets/keyboard.jpg" alt="BLE Keyboard"></div><h3>BLE Keyboard</h3><p class="ds" data-i18n="p.kb.ds">Card-sized full keyboard with gyro air-mouse and white backlight. Bluetooth 5.2 or USB-C.</p><div class="foot"><span class="pr" data-usd="39">$39</span><button class="add" data-add="keyboard" aria-label="Add">+</button></div></a>
      <a class="pc" href="/diysuite"><div class="ph"><img src="/assets/diysuite.jpg" alt="DIY Suite"></div><h3>DIY Suite</h3><p class="ds" data-i18n="p.diy.ds">Solder your own 48-key keyboard in an afternoon. Open-source PCB and QMK firmware.</p><div class="foot"><span class="pr" data-usd="9">$9</span><button class="add" data-add="diysuite" aria-label="Add">+</button></div></a>
      <a class="pc" href="/picomac"><div class="ph"><img src="/assets/picomac.jpg" alt="Pico-Mac Nano"></div><h3>Pico-Mac Nano</h3><p class="ds" data-i18n="p.mac.ds">A 1984 Macintosh shrunk to your palm. Boots real classic Mac OS over USB-C.</p><div class="foot"><span class="pr" data-usd="60">$60</span><button class="add" data-add="picomac" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><span class="tag" data-i18n="tag.new">New</span><img src="/assets/cm0-adapter.png" alt="CM0→CM4 adapter (CM0 soldered)"></div><h3>CM0 Adapter</h3><p class="ds" data-i18n="p.cm0adp.ds">CM0 pre-soldered on a CM0→CM4 adapter. Drops straight into any CM4 socket.</p><div class="foot"><span class="pr" data-usd="40">$40</span><button class="add" data-add="cm0-adapter" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><img src="/assets/cm0-module.jpeg" alt="CM0 module"></div><h3>CM0 Module</h3><p class="ds" data-i18n="p.cm0.ds">Standalone CM0 compute module — castellated 132-pin, for your own adapter or board.</p><div class="foot"><span class="pr" data-usd="30">$30</span><button class="add" data-add="cm0-module" aria-label="Add">+</button></div></a>
      <a class="pc" href="/typixdeck#buy"><div class="ph"><img src="/assets/cm0-adapter-raw.png" alt="CM0→CM4 adapter bare board"></div><h3>CM0 Adapter (bare)</h3><p class="ds" data-i18n="p.cm0raw.ds">Bare CM0→CM4 adapter PCB. Solder your own CM0 and go.</p><div class="foot"><span class="pr" data-usd="10">$10</span><button class="add" data-add="cm0-adapter-raw" aria-label="Add">+</button></div></a>
    </div>
  </div></section>

  <section id="why"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="why.kicker">Why TypixNode</span><h2 data-i18n="why.title">Built small. Built open.</h2></div>
    <div class="feat">
      <div class="c"><div class="ic">❄</div><h4 data-i18n="why.1t">Fanless &amp; silent</h4><p data-i18n="why.1p">CNC aluminum bodies double as heatsinks — full performance at 0 dB, no fans to fail.</p></div>
      <div class="c"><div class="ic">⚿</div><h4 data-i18n="why.2t">Fully open source</h4><p data-i18n="why.2p">Schematics, firmware and STEP files are all public, so you can repair, mod and build on everything.</p></div>
      <div class="c"><div class="ic">▭</div><h4 data-i18n="why.3t">Pocket-sized</h4><p data-i18n="why.3p">From a palm computer to a card-sized keyboard, every device is made to travel with you.</p></div>
    </div>
  </div></section>

  <section id="compat"><div class="wrap">
    <div class="head">
      <span class="mono" data-i18n="compat.kicker">Software &amp; compatibility</span>
      <h2 data-i18n="compat.title">Run everything you love on TypixDeck</h2>
      <p class="compat-sub" data-i18n="compat.sub">It runs mainline Linux on Raspberry Pi — so the whole open-source world comes with it. A taste of what just works.</p>
    </div>

    <div class="compat-grid">
      <div class="compat-group">
        <h3 data-i18n="compat.g.os">Operating systems</h3>
        <ul class="compat-items">
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="5"/><path d="M7 14c-1.2 1.4-2 3-2 4.5C5 21 8 22 12 22s7-1 7-3.5c0-1.5-.8-3.1-2-4.5"/><circle cx="10" cy="8.5" r="1.1"/><circle cx="14" cy="8.5" r="1.1"/></svg></span><span>Raspberry Pi OS</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg></span><span>Debian</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="12" r="2.3"/><circle cx="16" cy="6.5" r="2.3"/><circle cx="16" cy="17.5" r="2.3"/><path d="M8.2 12h2M9 11l5-4M9 13l5 4"/></svg></span><span>Ubuntu</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 20h16L12 3Z"/><path d="M12 9 8.5 17h7L12 9Z" fill="none"/></svg></span><span>Arch Linux ARM</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21c2-6 4-10 7-14M12 7c2 2 4 6 4 10M9 12l3-2 3 2"/></svg></span><span>Kali Linux</span></li>
        </ul>
      </div>

      <div class="compat-group">
        <h3 data-i18n="compat.g.emu">Retro gaming &amp; emulators</h3>
        <ul class="compat-items">
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="5"/><path d="M8 10v4M6 12h4"/><circle cx="16" cy="11" r="1.1"/><circle cx="18" cy="14" r="1.1"/></svg></span><span>RetroArch</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M7 9h10M7 12h6M7 15h8"/></svg></span><span>DOSBox</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="8" rx="4"/><circle cx="8" cy="12" r="1.4"/><path d="M14 11h4M16 10v2"/></svg></span><span>PPSSPP</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="16" rx="2"/><rect x="8" y="7" width="8" height="6"/><circle cx="12" cy="17" r="1.4"/></svg></span><span>mGBA</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c5 0 8 4 8 9s-3 9-8 9-8-4-8-9 3-9 8-9Z"/><path d="M9 12h6M12 9v6"/></svg></span><span>Dolphin</span></li>
        </ul>
      </div>

      <div class="compat-group">
        <h3 data-i18n="compat.g.engine">Game engines &amp; creation</h3>
        <ul class="compat-items">
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9c0-2 4-3 8-3s8 1 8 3v4c0 3-4 5-8 5s-8-2-8-5V9Z"/><circle cx="9" cy="11" r="1.1"/><circle cx="15" cy="11" r="1.1"/></svg></span><span>Godot</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 6-7 10-7 10Z"/></svg></span><span>LÖVE2D</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 8h3v3H8zM13 8h3v3h-3zM8 13h3v3H8zM13 13h3v3h-3z"/></svg></span><span>PICO-8</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M7 9h10M7 12h10M7 15h7"/></svg></span><span>TIC-80</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18 12 5l8 13M8 18l4-7 4 7"/></svg></span><span>Raylib</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4v16M4 12h16"/></svg></span><span>Phaser</span></li>
        </ul>
      </div>

      <div class="compat-group">
        <h3 data-i18n="compat.g.sdr">Software-defined radio</h3>
        <ul class="compat-items">
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V8M19 19V5M9 19v-7M13 19v-4M17 19v-9"/></svg></span><span>GQRX</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12c2-4 4-4 6 0s4 4 6 0 4-4 6 0"/><path d="M3 17c2-4 4-4 6 0"/></svg></span><span>GNU Radio</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M7 7a7 7 0 0 0 0 10M17 7a7 7 0 0 1 0 10M4 4a11 11 0 0 0 0 16M20 4a11 11 0 0 1 0 16"/></svg></span><span>SDR++</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v5M12 8 7 21M12 8l5 13"/><circle cx="12" cy="3" r="1.5"/></svg></span><span>CubicSDR</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 16V9M8 16V6M12 16v-9M16 16V8M20 16v-5M3 19h18"/></svg></span><span>rtl_433</span></li>
        </ul>
      </div>

      <div class="compat-group">
        <h3 data-i18n="compat.g.desktop">Desktop &amp; development</h3>
        <ul class="compat-items">
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="12" rx="1"/><path d="M3 20h18"/><circle cx="12" cy="11" r="2"/></svg></span><span>X.Org</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 14c3-6 6-6 9 0s6 6 9 0"/><path d="M3 9c3 6 6 6 9 0"/></svg></span><span>Wayland</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 3 6 9v6l10 6 4-2V5l-4-2Z"/><path d="M6 9l10 12M6 15l10-12"/></svg></span><span>VS Code</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h4l4 14L16 5h4"/></svg></span><span>Vim</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12a4 4 0 0 0 8 0"/><circle cx="9" cy="9" r="1"/><circle cx="15" cy="9" r="1"/></svg></span><span>Emacs</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="6" r="2"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="9" r="2"/><path d="M7 8v8M7 16c0-4 10-3 10-7"/></svg></span><span>git</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.5"/><path d="M12 8.5H21M9 13.5l-4.5 7.8M15 13.5l4.5 7.8"/></svg></span><span>Chromium</span></li>
        </ul>
      </div>

      <div class="compat-group">
        <h3 data-i18n="compat.g.media">Media &amp; office</h3>
        <ul class="compat-items">
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 19h14L12 3Z"/><path d="M9 16h6"/></svg></span><span>VLC</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M10 9l5 3-5 3V9Z"/></svg></span><span>MPlayer</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="16" r="2.5"/><circle cx="17" cy="13" r="2.5"/><path d="M10.5 16V6l9-2v9"/></svg></span><span>Mixxx</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 4v3M20 12h-3"/></svg></span><span>OBS</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z"/><path d="M10 8v8M10 16h4"/></svg></span><span>LibreOffice</span></li>
          <li><span class="ci"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M6 5l5 8 5-8M16 5v14"/></svg></span><span>LaTeX</span></li>
        </ul>
      </div>
    </div>

    <p class="compat-disclaimer" data-i18n="compat.disc">All trademarks belong to their respective owners; logos shown only to indicate software compatibility.</p>
  </div></section>

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="cta.home.t">Start with TypixDeck</h2>
      <p data-i18n="cta.home.p">A silent, open, CNC-aluminum Linux computer that fits in your hand. Built on the open Raspberry Pi ecosystem shared by millions of developers worldwide.</p>
      <div class="cta"><a class="btn btn--fill" href="/typixdeck" data-i18n="cta.home.b1">Meet TypixDeck</a><a class="btn btn--glass" href="/products" data-i18n="cta.home.b2">See all products</a></div>
    </div>
  </div></section>

  </div>

  <Footer />
  <CartDrawer />
</Layout>

<style is:global>
  /* ===== Homepage hero — finalized layout: left text / right image =====
     The default markup renders the hero copy on the left and the product
     stage on the right. This restructures only the hero visuals; i18n,
     cart, 3D viewer, nav and Lineup are untouched. */
  .home-root .hero-copy{display:contents}

  .home-root header.home{text-align:left;padding:48px 0 24px}
  /* Hero: wide left copy + image pulled close (tight 14px gap), columns
     vertically centered so the product image is centered against the copy. */
  .home-root header.home .wrap{
    display:grid;grid-template-columns:1.5fr 1fr;gap:14px;align-items:center}
  .home-root .hero-copy{display:flex;flex-direction:column;align-items:flex-start}
  .home-root header.home .lead{margin-left:0;margin-right:0;max-width:54ch}
  .home-root header.home .cta{justify-content:flex-start}
  /* Main title sized so the Chinese headline doesn't wrap so much. */
  .home-root header.home h1{font-size:clamp(2.4rem,6.1vw,4.2rem)}
  /* No top/bottom margin override — let align-items:center vertically center
     the product image against the (taller) copy column. */
  .home-root .stage.home{max-width:none;width:100%;align-self:center}

  @media(max-width:900px){
    .home-root header.home .wrap{grid-template-columns:1fr;gap:24px}
    .home-root .stage.home{margin-top:8px}
  }

  /* ===== Software & compatibility wall ===== */
  #compat .compat-sub{max-width:62ch;margin:10px auto 0;opacity:.78}
  #compat .head{margin-bottom:32px}
  .compat-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:24px}
  .compat-group{
    border:1px solid var(--line2);
    border-radius:16px;padding:20px 18px;
    background:var(--glass)}
  .compat-group h3{
    font-size:.82rem;letter-spacing:.04em;text-transform:uppercase;
    margin:0 0 14px;color:var(--soft);font-weight:600}
  .compat-items{
    list-style:none;margin:0;padding:0;
    display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));
    gap:10px 8px}
  .compat-items li{
    display:flex;align-items:center;gap:9px;
    font-size:.86rem;line-height:1.2;color:var(--ink)}
  .compat-items .ci{
    flex:0 0 auto;width:30px;height:30px;border-radius:8px;
    display:grid;place-items:center;
    background:var(--line2);color:var(--ink)}
  .compat-items .ci svg{
    width:18px;height:18px;
    fill:none;stroke:currentColor;stroke-width:1.6;
    stroke-linecap:round;stroke-linejoin:round}
  .compat-disclaimer{
    margin-top:26px;text-align:center;
    font-size:.74rem;color:var(--soft2);line-height:1.5}

  @media(max-width:520px){
    .compat-items{grid-template-columns:repeat(auto-fill,minmax(104px,1fr))}
  }
</style>
