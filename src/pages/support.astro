---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
const links = [
  { href: '/products', key: 'nav.all', label: 'All products' },
  { href: '/typixdeck', key: 'nav.deck', label: 'TypixDeck' },
  { href: '/about', key: 'ft.about', label: 'About' },
];
---
<Layout
  title="Support — TypixNode"
  titleKey="support.doc"
  description="TypixNode support — shipping, returns, warranty and setup. Free worldwide shipping, 30-day returns and a 2-year warranty."
  ogTitle="Support — TypixNode"
  ogDescription="Shipping, returns, warranty and setup — the essentials, plus a human who replies."
>
  <Nav links={links} showBuy={false} />

  <section style="padding-top:64px"><div class="wrap">
    <div class="head">
      <span class="mono" data-i18n="support.kicker" set:html={L('support.kicker', lang)}></span>
      <h2 data-i18n="support.h1" set:html={L('support.h1', lang)}></h2>
      <p data-i18n="support.lead" set:html={L('support.lead', lang)}></p>
    </div>
    <div class="feat">
      <div class="c"><div class="ic">✈</div><h4 data-i18n="support.s1t" set:html={L('support.s1t', lang)}></h4><p data-i18n="support.s1p" set:html={L('support.s1p', lang)}></p></div>
      <div class="c"><div class="ic">↩</div><h4 data-i18n="support.s2t" set:html={L('support.s2t', lang)}></h4><p data-i18n="support.s2p" set:html={L('support.s2p', lang)}></p></div>
      <div class="c"><div class="ic">⛨</div><h4 data-i18n="support.s3t" set:html={L('support.s3t', lang)}></h4><p data-i18n="support.s3p" set:html={L('support.s3p', lang)}></p></div>
      <div class="c"><div class="ic">✉</div><h4 data-i18n="support.s4t" set:html={L('support.s4t', lang)}></h4><p data-i18n="support.s4p" set:html={L('support.s4p', lang)}></p></div>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="support.s4t" set:html={L('support.s4t', lang)}></h2>
      <p data-i18n="support.s4p" set:html={L('support.s4p', lang)}></p>
      <div class="cta"><a class="btn btn--fill" href="mailto:hello@typixnode.com">hello@typixnode.com</a><a class="btn btn--glass" href="/products" data-i18n="see.all" set:html={L('see.all', lang)}></a></div>
    </div>
  </div></section>

  <Footer />
  <CartDrawer />
</Layout>
