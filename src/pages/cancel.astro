---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
export const prerender = false;
---
<Layout title="Checkout canceled — TypixNode" noindex={true}>
  <nav><div class="nav">
    <a class="brand" href="/"><img class="logo-lt" src="/assets/typixnode-logo.svg" alt="TypixNode"><img class="logo-dk" src="/assets/typixnode-logo-inverse.svg" alt="TypixNode"></a>
    <span class="sp"></span>
    <div class="ctrls">
      <button class="ctrl themebtn" aria-label="Toggle theme"><span class="ti">☾</span></button>
    </div>
  </div></nav>

  <section style="min-height:64vh;display:grid;place-items:center;text-align:center"><div class="wrap">
    <h2 style="font-weight:800;font-size:clamp(1.6rem,4vw,2.4rem);margin:12px 0 12px">Checkout canceled</h2>
    <p style="color:var(--soft);max-width:48ch;margin:0 auto 26px">
      No charge was made. Your cart is still saved — you can pick up where you left off.
    </p>
    <a class="btn btn--fill" href="/">Back to home</a>
  </div></section>

  <Footer />
</Layout>
