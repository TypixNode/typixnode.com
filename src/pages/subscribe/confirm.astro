---
// GET /subscribe/confirm?token=... — double opt-in landing.
// Confirms the subscription (idempotent) and sends a welcome email on the
// first successful confirmation.
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { confirmByToken, getByToken, logEmail } from '../../lib/subscribers';
import { sendEmail, welcomeHtml } from '../../lib/email';

export const prerender = false;

const env = (Astro.locals as any).runtime?.env as Env;
const site = env?.PUBLIC_SITE_URL || 'https://typixnode.com';
const token = Astro.url.searchParams.get('token') || '';

let state: 'ok' | 'already' | 'invalid' = 'invalid';

if (env?.DB && token) {
  const before = await getByToken(env.DB, token);
  if (before) {
    const wasActive = before.status === 'active';
    const sub = await confirmByToken(env.DB, token);
    if (sub) {
      state = wasActive ? 'already' : 'ok';
      if (!wasActive) {
        // First-time confirmation → welcome email (best-effort).
        const unsubUrl = `${site}/unsubscribe?token=${sub.token}`;
        const subject = 'Welcome to TypixNode';
        const sent = await sendEmail({
          apiKey: env.RESEND_API_KEY,
          from: env.FROM_EMAIL || 'TypixNode <onboarding@resend.dev>',
          to: sub.email,
          subject,
          html: welcomeHtml({ unsubscribeUrl: unsubUrl, name: sub.name }),
        });
        await logEmail(env.DB, 'welcome', sub.email, subject, sent ? 'sent' : 'skipped');
      }
    }
  }
}

const copy = {
  ok: { emoji: '🎉', title: "You're subscribed!", body: 'Thanks for confirming. Watch your inbox for product news, restocks and open-source drops.' },
  already: { emoji: '✅', title: 'Already confirmed', body: "You're already on the list — nothing more to do. Thanks for being here!" },
  invalid: { emoji: '⚠️', title: 'Link expired or invalid', body: "We couldn't confirm this subscription. The link may have expired — please subscribe again from our site." },
}[state];
---
<Layout title="Subscription confirmed — TypixNode" noindex={true}>
  <nav><div class="nav">
    <a class="brand" href="/"><img class="logo-lt" src="/assets/typixnode-logo.svg" alt="TypixNode"><img class="logo-dk" src="/assets/typixnode-logo-inverse.svg" alt="TypixNode"></a>
    <span class="sp"></span>
    <div class="ctrls">
      <button class="ctrl themebtn" aria-label="Toggle theme"><span class="ti">☾</span></button>
    </div>
  </div></nav>

  <section style="min-height:64vh;display:grid;place-items:center;text-align:center"><div class="wrap">
    <div style="font-size:3rem;line-height:1;margin-bottom:8px">{copy.emoji}</div>
    <h2 style="font-weight:800;font-size:clamp(1.6rem,4vw,2.4rem);margin:6px 0 12px">{copy.title}</h2>
    <p style="color:var(--soft);max-width:48ch;margin:0 auto 26px">{copy.body}</p>
    <a class="btn btn--fill" href="/products">Explore products</a>
  </div></section>

  <Footer />
</Layout>
