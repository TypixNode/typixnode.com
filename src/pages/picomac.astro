---
import { L } from "../lib/i18n";
const lang = (Astro.locals as any).lang ?? "en";
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Lineup from '../components/Lineup.astro';
const links = [
  { href: '#features', key: 'nav.features', label: 'Features' },
  { href: '#specs', key: 'nav.specs', label: 'Specs' },
  { href: '#faq', key: 'nav.faq', label: 'FAQ' },
  { href: '/products', key: 'nav.all', label: 'All products' },
];
---
<Layout
  title="Pico-Mac Nano — a palm-sized 1984 Macintosh | TypixNode"
  titleKey="doc.mac"
  description="The TypixNode Pico-Mac Nano — a palm-sized 1984 Macintosh that actually boots classic Mac OS over USB-C, Happy Mac and all."
  ogTitle="Pico-Mac Nano — a palm-sized 1984 Macintosh"
  ogDescription="A palm-sized 1984 Macintosh that actually boots classic Mac OS over USB-C, Happy Mac and all."
>
  <Nav links={links} buyAdd="picomac" />

  <header class="prod"><div class="wrap">
    <div class="hero">
      <div class="copy">
        <span class="chip rise d1"><span class="d"></span><span class="mono" data-i18n="hero.badge" set:html={L('hero.badge', lang)}></span></span>
        <h1 class="rise d2" data-i18n="mac.h1" set:html={L('mac.h1', lang)}></h1>
        <p class="lead rise d3" data-i18n="mac.lead" set:html={L('mac.lead', lang)}></p>
        <div class="price rise d3"><b data-sku="picomac" data-usd="60">$60</b><span class="ship" data-i18n="deck.ship" set:html={L('deck.ship', lang)}></span></div>
        <div class="cta rise d3"><button class="btn btn--fill" data-add="picomac" data-i18n="cart.add" set:html={L('cart.add', lang)}></button><a class="btn btn--glass" href="#features" data-i18n="look" set:html={L('look', lang)}></a></div>
        <div class="trust rise d4"><span class="d"></span> <span data-i18n="deck.trust" set:html={L('deck.trust', lang)}></span></div>
      </div>
      <div class="stage rise d4">
        <span class="pin p1"><div class="k">Pico-Mac Nano</div><div class="v" data-i18n="mac.s2l" set:html={L('mac.s2l', lang)}></div></span>
        <img src="/assets/picomac.jpg" alt="TypixNode Pico-Mac Nano" style="border-radius:18px">
        <span class="pin p2"><div class="k"><span data-usd="60">$60</span></div><div class="v" data-i18n="pin.stock" set:html={L('pin.stock', lang)}></div></span>
      </div>
    </div>
    <div class="strip rise d4"><div class="in">
      <div class="stat"><div class="n grad">2″</div><div class="l" data-i18n="mac.s1l" set:html={L('mac.s1l', lang)}></div></div>
      <div class="stat"><div class="n grad">1984</div><div class="l" data-i18n="mac.s2l" set:html={L('mac.s2l', lang)}></div></div>
      <div class="stat"><div class="n grad">90 g</div><div class="l" data-i18n="mac.s3l" set:html={L('mac.s3l', lang)}></div></div>
      <div class="stat"><div class="n grad">USB-C</div><div class="l" data-i18n="mac.s4l" set:html={L('mac.s4l', lang)}></div></div>
      <div class="social" data-i18n="st.social" set:html={L('st.social', lang)}></div>
    </div></div>
  </div></header>

  <section><div class="wrap">
    <div class="rows"><div class="row">
      <div class="rimg"><img src="/assets/picomac-front.jpg" alt="Pico-Mac Nano display"></div>
      <div class="rtxt"><div class="ic">Pico-Mac Nano</div><h3 data-i18n="mac.row.t" set:html={L('mac.row.t', lang)}></h3><p data-i18n="mac.row.p" set:html={L('mac.row.p', lang)}></p></div>
    </div></div>
  </div></section>

  <section id="features"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="f.kicker" set:html={L('f.kicker', lang)}></span><h2 data-i18n="mac.feat" set:html={L('mac.feat', lang)}></h2></div>
    <div class="feat">
      <div class="c"><div class="ic">☺</div><h4 data-i18n="mac.f1t" set:html={L('mac.f1t', lang)}></h4><p data-i18n="mac.f1p" set:html={L('mac.f1p', lang)}></p></div>
      <div class="c"><div class="ic">⏻</div><h4 data-i18n="mac.f2t" set:html={L('mac.f2t', lang)}></h4><p data-i18n="mac.f2p" set:html={L('mac.f2p', lang)}></p></div>
      <div class="c"><div class="ic">◳</div><h4 data-i18n="mac.f3t" set:html={L('mac.f3t', lang)}></h4><p data-i18n="mac.f3p" set:html={L('mac.f3p', lang)}></p></div>
    </div>
  </div></section>

  <section id="specs"><div class="wrap">
    <div class="head"><span class="mono">Pico-Mac Nano</span><h2 data-i18n="sp.title" set:html={L('sp.title', lang)}></h2></div>
    <div class="spectbl">
      <div class="r"><div class="k" data-i18n="mac.spk1" set:html={L('mac.spk1', lang)}></div><div class="v" data-i18n="mac.spv1" set:html={L('mac.spv1', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="mac.spk2" set:html={L('mac.spk2', lang)}></div><div class="v" data-i18n="mac.spv2" set:html={L('mac.spv2', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="mac.spk3" set:html={L('mac.spk3', lang)}></div><div class="v" data-i18n="mac.spv3" set:html={L('mac.spv3', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="mac.spk4" set:html={L('mac.spk4', lang)}></div><div class="v" data-i18n="mac.spv4" set:html={L('mac.spv4', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="mac.spk5" set:html={L('mac.spk5', lang)}></div><div class="v" data-i18n="mac.spv5" set:html={L('mac.spv5', lang)}></div></div>
      <div class="r"><div class="k" data-i18n="mac.spk6" set:html={L('mac.spk6', lang)}></div><div class="v" data-i18n="mac.spv6" set:html={L('mac.spv6', lang)}></div></div>
    </div>
  </div></section>

  <section id="faq"><div class="wrap">
    <div class="head"><span class="mono" data-i18n="faq.kicker" set:html={L('faq.kicker', lang)}></span><h2 data-i18n="faq.title" set:html={L('faq.title', lang)}></h2></div>
    <div class="faq">
      <div class="qa"><button><span data-i18n="mac.q1" set:html={L('mac.q1', lang)}></span> <span class="pm">+</span></button><div class="ans"><p data-i18n="mac.a1" set:html={L('mac.a1', lang)}></p></div></div>
      <div class="qa"><button><span data-i18n="mac.q2" set:html={L('mac.q2', lang)}></span> <span class="pm">+</span></button><div class="ans"><p data-i18n="mac.a2" set:html={L('mac.a2', lang)}></p></div></div>
    </div>
  </div></section>

  <Lineup />

  <section><div class="wrap">
    <div class="ctab">
      <h2 data-i18n="mac.cta.t" set:html={L('mac.cta.t', lang)}></h2>
      <p data-i18n="mac.cta.p" set:html={L('mac.cta.p', lang)}></p>
      <div class="cta"><button class="btn btn--fill" data-add="picomac" data-i18n="cart.add" set:html={L('cart.add', lang)}></button><a class="btn btn--glass" href="/products" data-i18n="see.all" set:html={L('see.all', lang)}></a></div>
    </div>
  </div></section>

  <Footer />
  <CartDrawer />
</Layout>
