---
// GET /unsubscribe?token=... — one-click unsubscribe landing (idempotent).
// The token is the subscriber's capability secret embedded in every email.
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { unsubscribeByToken, getByToken } from '../lib/subscribers';

export const prerender = false;

const env = (Astro.locals as any).runtime?.env as Env;
const token = Astro.url.searchParams.get('token') || '';

let state: 'ok' | 'invalid' = 'invalid';
let email = '';

if (env?.DB && token) {
  const sub = await unsubscribeByToken(env.DB, token);
  if (sub) {
    state = 'ok';
    email = sub.email;
  } else {
    const existing = await getByToken(env.DB, token);
    if (existing) {
      state = 'ok';
      email = existing.email;
    }
  }
}

const copy = {
  ok: { emoji: '👋', title: "You've been unsubscribed", body: email ? `${email} won't receive any more mailing-list emails. Changed your mind? You can re-subscribe from our site anytime.` : "You won't receive any more mailing-list emails." },
  invalid: { emoji: '⚠️', title: 'Link invalid', body: "We couldn't find that subscription. It may already be removed." },
}[state];
---
<Layout title="Unsubscribe — TypixNode" noindex={true}>
  <nav><div class="nav">
    <a class="brand" href="/"><img class="logo-lt" src="/assets/typixnode-logo.svg" alt="TypixNode"><img class="logo-dk" src="/assets/typixnode-logo-inverse.svg" alt="TypixNode"></a>
    <span class="sp"></span>
    <div class="ctrls">
      <button class="ctrl themebtn" aria-label="Toggle theme"><span class="ti">☾</span></button>
    </div>
  </div></nav>

  <section style="min-height:64vh;display:grid;place-items:center;text-align:center"><div class="wrap">
    <div style="font-size:3rem;line-height:1;margin-bottom:8px">{copy.emoji}</div>
    <h2 style="font-weight:800;font-size:clamp(1.6rem,4vw,2.4rem);margin:6px 0 12px">{copy.title}</h2>
    <p style="color:var(--soft);max-width:48ch;margin:0 auto 26px">{copy.body}</p>
    <a class="btn btn--fill" href="/">Back to home</a>
  </div></section>

  <Footer />
</Layout>
