---
import { L } from '../lib/i18n';
interface Props {
  title: string;
  description?: string;
  titleKey?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'TypixNode builds compact open hardware — a CNC-aluminum Linux computer, a card-sized keyboard, and a palm-sized Macintosh. Open-source, shipped worldwide.',
  titleKey,
  canonical,
  ogTitle,
  ogDescription,
  noindex = false,
} = Astro.props;
const site = 'https://typixnode.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;

// Language resolved server-side by src/middleware.ts (cookie → Accept-Language → 'en').
// Rendering the page in this language avoids the first-paint English→target flash.
const lang = (Astro.locals as any).lang ?? 'en';
// Document title: prefer the translated titleKey so the <title> is correct on
// first paint too (site.js no longer needs to rewrite it).
const docTitle = titleKey ? L(titleKey, lang) : title;

// Payment config exposed to the browser (publishable values only — never secrets).
const env = (Astro.locals as any).runtime?.env ?? {};
const paypalClientId: string = env.PAYPAL_CLIENT_ID ?? '';
// Stripe is intentionally disabled for now (requires a HK entity to take live
// payments; mainland-China company can't activate it). Code is retained and
// auto-re-enables if STRIPE_ENABLED is set truthy in the future.
const stripeEnabled: boolean = String(env.STRIPE_ENABLED ?? '') === '1';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TypixNode" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${site}/assets/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/typixnode-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <script is:inline define:vars={{ ssrLang: lang }}>
      // Language was chosen server-side and the HTML is already rendered in it.
      // Expose it so site.js adopts the same language instead of re-detecting
      // (which would cause a redundant re-translate / flash).
      window.__TNX_LANG = ssrLang;
      (function () {
        try {
          var t = localStorage.getItem('tnx-theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-title-key={titleKey}>
    <slot />
    <script is:inline define:vars={{ paypalClientId, stripeEnabled }}>
      window.TNX_CFG = {
        paypalClientId: paypalClientId || '',
        stripeEnabled: !!stripeEnabled,
      };
    </script>
    {paypalClientId && (
      <script
        is:inline
        src={`https://www.paypal.com/sdk/js?client-id=${paypalClientId}&currency=USD&intent=capture`}
      ></script>
    )}
    <script src="/assets/js/site.js" is:inline></script>
    <script src="/assets/js/liquid-glass.js" is:inline></script>
  </body>
</html>
