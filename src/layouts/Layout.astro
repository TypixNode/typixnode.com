---
interface Props {
  title: string;
  description?: string;
  titleKey?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'TypixNode builds compact open hardware — a fanless milled-aluminum Linux computer, a card-sized keyboard, and a palm-sized Macintosh. Open-source, shipped worldwide.',
  titleKey,
  canonical,
  ogTitle,
  ogDescription,
  noindex = false,
} = Astro.props;
const site = 'https://typixnode.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TypixNode" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${site}/assets/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/typixnode-logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/site.css" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('tnx-theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-title-key={titleKey}>
    <slot />
    <script src="/assets/js/site.js" is:inline></script>
  </body>
</html>
